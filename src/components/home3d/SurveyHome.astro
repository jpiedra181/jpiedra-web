---
//@ts-nocheck
// La home: el levantamiento de la Sierra de Guadarrama en 3D. Es un documento
// propio (sin BaseLayout) y sirve a los dos idiomas: src/pages/index.astro y
// src/pages/en/index.astro. La versión clásica (el plano impreso, sin WebGL)
// tiene su propia ruta y se enlaza desde la cabecera y desde el botón
// «Fin del mundo», que antes de llevar allí arrasa la sierra con un meteorito.
import "../../styles/global.css"
import type { Lang } from "../../types"
import { surveyVerticesFor } from "../../data/survey-vertices"
import { routesFor, siteConfig } from "../../config/site"
import { useTranslations } from "../../i18n/utils"
import SeoHead from "../layout/SeoHead.astro"
import LanguageSwitcher from "../ui/LanguageSwitcher.astro"
import serifFont from "../../assets/fonts/newsreader-latin-opsz-400-normal.woff2?url"
import serifItalicFont from "../../assets/fonts/newsreader-latin-opsz-400-italic.woff2?url"
import sansFont from "@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url"

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const copy = useTranslations(lang).survey3d
const routes = routesFor(lang)
const vertices = surveyVerticesFor(lang)

// En producción el tiempo llega de AEMET (función de Netlify); en desarrollo,
// de Open-Meteo. La atribución tiene que nombrar la fuente que se usa. Una
// sola línea corta con las tres fuentes, como admiten las guías de atribución
// de OpenStreetMap cuando falta espacio. En móvil el nombre de la sierra pasa
// a la hoja «Qué hago» y bajo el titular quedan solo las fuentes.
// Guion que no parte línea (U+2011): a 320 px quedaba «Open-» al final.
const weatherSource = import.meta.env.PROD ? "© AEMET" : "Open‑Meteo"
const credits = `${copy.dataLabel}: © IGN · © OpenStreetMap · ${weatherSource}`

// Datos estructurados de la marca: la persona y el sitio web.
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Person",
            "@id": `${siteConfig.url}/#javier-piedra`,
            name: "Javier Piedra",
            url: siteConfig.url,
            email: siteConfig.email,
            jobTitle: lang === "es" ? "Diseñador y desarrollador web" : "Web designer and developer",
            knowsAbout: lang === "es"
                ? ["Experiencias web 3D", "WebGL", "Accesibilidad web", "WCAG 2.2", "Ley 11/2023"]
                : ["3D web experiences", "WebGL", "Web accessibility", "WCAG 2.2", "European Accessibility Act"],
            sameAs: [siteConfig.socials.linkedin, siteConfig.socials.github],
        },
        {
            "@type": "WebSite",
            "@id": `${siteConfig.url}/#website`,
            name: "Javier Piedra",
            url: siteConfig.url,
            inLanguage: ["es", "en"],
            publisher: { "@id": `${siteConfig.url}/#javier-piedra` },
        },
    ],
}
---

<!doctype html>
<html lang={lang}>
    <head>
        <SeoHead
            lang={lang}
            title={copy.meta.title}
            description={copy.meta.description}
            structuredData={structuredData}
        />
        <!-- Las tres fuentes del titular: precargadas, el texto aparece sin esperar. -->
        <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={serifItalicFont} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
        <!-- Con JavaScript, la lista de vértices espera a la escena para no
             pintarse un instante fuera de sitio (salto de maquetación). -->
        <script is:inline>document.documentElement.classList.add("js")</script>
        <!-- Los datos del terreno no se precargan: competirían por el ancho de
             banda con las fuentes del titular, y la escena ya espera a que el
             titular esté pintado para cargarlos. -->
    </head>
    <body class="survey">
        <canvas id="survey-canvas" class="survey-canvas" aria-hidden="true"
        ></canvas>

        <header class="survey-header">
            <a href={routes.home} class="survey-logo">
                <span aria-hidden="true">J<span class="text-accent">.</span>P</span>
                <span class="sr-only">{copy.homeLabel}</span>
            </a>
            <!-- Solo en pantallas pequeñas (survey/compact-ui.ts). Va antes
                 del menú: al abrirlo, Tab sigue por sus enlaces. -->
            <button
                type="button"
                class="survey-menu-button"
                data-menu-button
                aria-expanded="false"
                aria-controls="survey-nav"
            >
                <span class="survey-menu-lines" aria-hidden="true"><span></span></span>
                <span class="sr-only">{copy.menu}</span>
            </button>
            <!-- Mismo orden relativo que la cabecera del resto de páginas
                 (Blog, EN, Hablemos): WCAG 3.2.3. -->
            <nav id="survey-nav" class="survey-nav" aria-label={copy.nav.label}>
                {lang === "es" && <a href={routes.blog}>{copy.nav.blog}</a>}
                <a href={routes.classic}>{copy.classic}</a>
                <LanguageSwitcher lang={lang} class="survey-language" />
                <a href={routes.contact} class="survey-nav-cta">{copy.nav.contact}</a>
            </nav>
        </header>

        <main class="survey-main">
            <div class="survey-intro">
                <p class="survey-eyebrow">{copy.eyebrow}</p>
                <h1 class="survey-title">
                    {copy.titleStart}
                    <em>{copy.titleHighlight}</em>
                    <span class="block">{copy.titleEnd}</span>
                </h1>
                <!-- Solo en pantallas pequeñas: el subtítulo, la pista y la
                     pregunta de cada cumbre pasan a la hoja «Qué hago». -->
                <button
                    type="button"
                    class="survey-more"
                    data-sheet-open
                    aria-haspopup="dialog"
                    aria-controls="survey-sheet"
                >
                    <span class="survey-more-icon" aria-hidden="true"></span>
                    {copy.more}
                </button>
                <div class="survey-details">
                    <p class="survey-subtitle">{copy.subtitle}</p>
                    <p class="survey-hint">{copy.hint}</p>
                </div>
                <p class="survey-caption">
                    <span class="survey-caption-place">{copy.caption} · </span>{credits}
                </p>
                <p class="sr-only">{copy.sceneDescription}</p>
            </div>

            <nav class="survey-vertices" aria-label={copy.verticesLabel}>
                <ul role="list">
                    {
                        vertices.map((vertex) => (
                            <li>
                                <a
                                    href={vertex.href}
                                    class="vertex"
                                    data-vertex
                                    data-lat={vertex.lat}
                                    data-lon={vertex.lon}
                                >
                                    <svg class="vertex-pin" viewBox="0 0 16 14" aria-hidden="true">
                                        <path d="M8 1 L15 13 L1 13 Z" />
                                        <circle cx="8" cy="9" r="1.6" />
                                    </svg>
                                    <span class="vertex-stem" aria-hidden="true" />
                                    <span class="vertex-card">
                                        <span class="vertex-label">{vertex.label}</span>
                                        <!-- Sin esto, el nombre del enlace junta etiqueta y resumen
                                             («Sobre míQuién soy») y NVDA lo lee de corrido. -->
                                        <span class="sr-only">. </span>
                                        <span class="vertex-summary">{vertex.summary}</span>
                                    </span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <div class="survey-controls">
                <!-- La alternativa sin arrastre al giro con el ratón o el
                     dedo (WCAG 2.5.7). Sin escena no hay nada que girar. -->
                <div class="survey-orbit" role="group" aria-label={copy.rotate.label}>
                    {
                        (["left", "right"] as const).map((side) => (
                            <button
                                type="button"
                                class="survey-button survey-button--ghost survey-button--icon"
                                data-rotate={side}
                            >
                                <svg class={`survey-rotate-icon survey-rotate-icon--${side}`} viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M5 13a7 7 0 1 0 2.05-4.95" />
                                    <path d="M7 3.6V8h4.4" />
                                </svg>
                                <span class="sr-only">{copy.rotate[side]}</span>
                            </button>
                        ))
                    }
                </div>
                <button
                    type="button"
                    class="survey-button survey-button--ghost"
                    data-pause
                    aria-pressed="false"
                >
                    <span class="survey-pause-icon" aria-hidden="true"></span>
                    <span class="survey-button-text">{copy.pause}</span>
                </button>
                <button
                    type="button"
                    class="survey-button survey-button--ghost"
                    data-sound
                    aria-pressed="false"
                >
                    <svg class="survey-sound-icon" viewBox="0 0 20 16" aria-hidden="true">
                        <path class="speaker" d="M2 5.5h3.5L10 2v12L5.5 10.5H2z" />
                        <path class="waves" d="M13 5a4 4 0 0 1 0 6M15.5 3a7 7 0 0 1 0 10" />
                        <path class="mute" d="M13 5.5l5 5M18 5.5l-5 5" />
                    </svg>
                    <span class="survey-button-text">{copy.sound}</span>
                </button>
                <!-- Es un enlace a la versión clásica: sin JavaScript (o antes de
                     que cargue la escena) lleva allí sin más. Con la escena,
                     primero cae el meteorito. -->
                <a
                    href={routes.classic}
                    class="survey-button survey-button--doom"
                    data-destroy
                    aria-describedby="survey-destroy-description"
                >
                    <svg class="survey-doom-icon" viewBox="0 0 20 20" aria-hidden="true">
                        <circle cx="6" cy="14" r="3.6" />
                        <path d="M9 10.5 16.5 3M10.5 13 18 6.5M7.5 8.5 12.5 3.5" />
                    </svg>
                    {copy.destroy}
                </a>
                <p id="survey-destroy-description" class="sr-only">{copy.destroyDescription}</p>
            </div>
        </main>

        <!-- Hoja «Qué hago» (pantallas pequeñas, survey/compact-ui.ts). En
             móvil el titular va solo sobre la sierra; aquí está lo demás,
             también la pregunta de cada cumbre, que en el mapa solo lleva
             su nombre (WCAG 1.4.10). Cerrada, no existe para nadie. -->
        <dialog id="survey-sheet" class="survey-sheet" aria-labelledby="survey-sheet-title">
            <div class="survey-sheet-header">
                <h2 id="survey-sheet-title" class="survey-sheet-title">{copy.more}</h2>
                <button type="button" class="survey-sheet-close" data-sheet-close>
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M5 5l10 10M15 5 5 15" />
                    </svg>
                    <span class="sr-only">{copy.close}</span>
                </button>
            </div>
            <p class="survey-sheet-lead">{copy.subtitle}</p>
            <ul class="survey-sheet-list" role="list">
                {
                    vertices.map((vertex) => (
                        <li>
                            <a href={vertex.href} class="survey-sheet-link" data-sheet-link>
                                <span class="survey-sheet-label">{vertex.label}</span>
                                <span class="sr-only">. </span>
                                <span class="survey-sheet-summary">{vertex.summary}</span>
                                <span class="survey-sheet-arrow" aria-hidden="true">→</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
            <p class="survey-sheet-hint">{copy.hint}</p>
            <p class="survey-sheet-credits">{copy.caption} · {credits}</p>
        </dialog>

        <div class="survey-reticle" data-reticle aria-hidden="true">
            <span class="reticle-ring"></span>
            <span class="reticle-cross"></span>
        </div>
        <div class="survey-doom-sky" data-doom-sky aria-hidden="true"></div>
        <div class="survey-fade" data-fade aria-hidden="true"></div>
        <div class="survey-flash" data-flash aria-hidden="true"></div>

        <script>
            import type { WeatherKind } from "../../scripts/survey/weather"
            import { wireSurveyControls } from "../../scripts/survey/controls"
            import { wireSurveyMenu, wireSurveySheet } from "../../scripts/survey/compact-ui"
            import { initPageTransitions } from "../../scripts/page-transition"
            import terrainMeta from "../../data/terrain/guadarrama-mdt25.json"

            initPageTransitions()
            wireSurveyMenu()
            wireSurveySheet()

            // El bloque de texto se coloca encima de los controles con su altura
            // real (--survey-controls-h): en móviles estrechos los botones pasan
            // a dos líneas y, con una altura fija, tapaban los créditos. En
            // móvil, la sombra que hay detrás del titular sigue su altura
            // (--survey-intro-h), plegado o desplegado.
            const controls = document.querySelector<HTMLElement>(".survey-controls")!
            const intro = document.querySelector<HTMLElement>(".survey-intro")!
            const setBlockHeights = () => {
                const style = document.documentElement.style
                style.setProperty("--survey-controls-h", `${controls.offsetHeight}px`)
                style.setProperty("--survey-intro-h", `${intro.offsetHeight}px`)
            }
            const blockObserver = new ResizeObserver(setBlockHeights)
            blockObserver.observe(controls)
            blockObserver.observe(intro)
            setBlockHeights()

            const query = <T extends Element>(selector: string) =>
                document.querySelector<T>(selector)!

            const vertexElements = Array.from(
                document.querySelectorAll<HTMLElement>("[data-vertex]"),
            )

            // ?momento=2026-12-21T18:30 (hora local) y ?tiempo=nieve permiten
            // enlazar directamente a un momento concreto de la sierra.
            const WEATHER_PARAMS: Record<string, WeatherKind> = {
                directo: "live", despejado: "clear", lluvia: "rain", nieve: "snow", niebla: "fog", viento: "wind",
                live: "live", clear: "clear", rain: "rain", snow: "snow", fog: "fog", wind: "wind",
            }
            const params = new URLSearchParams(location.search)
            const momentParam = params.get("momento") ?? params.get("moment")
            const requestedMoment = momentParam ? new Date(momentParam) : null
            const initialMoment =
                requestedMoment && !Number.isNaN(requestedMoment.valueOf()) ? requestedMoment : null
            const initialWeather = WEATHER_PARAMS[params.get("tiempo") ?? params.get("weather") ?? "live"] ?? "live"

            // La escena (three.js y el relieve: unos 420 KB) se pide cuando el
            // titular ya está pintado con sus fuentes. Un solo fotograma de
            // espera no basta: a veces el import salía antes de pintar y, en
            // una red móvil lenta, competía con el titular (LCP) por la red.
            const SCENE_IDLE_TIMEOUT_MS = 600
            // Una pestaña abierta en segundo plano no notifica el LCP: sin
            // este plazo, la escena no llegaría a cargarse.
            const SCENE_FALLBACK_MS = 2000
            const afterHeadlinePaint = () =>
                new Promise<void>((resolve) => {
                    const whenIdle = () =>
                        "requestIdleCallback" in window
                            ? requestIdleCallback(() => resolve(), { timeout: SCENE_IDLE_TIMEOUT_MS })
                            : setTimeout(resolve, 0)
                    if (!PerformanceObserver.supportedEntryTypes?.includes("largest-contentful-paint")) {
                        requestAnimationFrame(() => requestAnimationFrame(whenIdle))
                        return
                    }
                    const fallback = setTimeout(whenIdle, SCENE_FALLBACK_MS)
                    const observer = new PerformanceObserver(() => {
                        observer.disconnect()
                        clearTimeout(fallback)
                        whenIdle()
                    })
                    observer.observe({ type: "largest-contentful-paint", buffered: true })
                })

            const loadScene = async () => {
                await document.fonts?.ready
                await afterHeadlinePaint()
                const { initSurveyScene } = await import("../../scripts/survey-scene")
                return initSurveyScene({
                    lang: document.documentElement.lang === "en" ? "en" : "es",
                    canvas: query<HTMLCanvasElement>("#survey-canvas"),
                    heightsUrl: "/levantamiento/guadarrama-mdt25.bin",
                    waterMaskUrl: "/levantamiento/guadarrama-agua.png",
                    villagesUrl: "/levantamiento/guadarrama-pueblos.png",
                    initialMoment,
                    initialWeather,
                    meta: terrainMeta,
                    vertices: vertexElements.map((element) => ({
                        element,
                        lat: Number(element.dataset.lat),
                        lon: Number(element.dataset.lon),
                        href: element.getAttribute("href") ?? undefined,
                    })),
                    reticle: query<HTMLElement>("[data-reticle]"),
                    fade: query<HTMLElement>("[data-fade]"),
                    layout: {
                        header: [
                            query<HTMLElement>(".survey-logo"),
                            query<HTMLElement>(".survey-nav"),
                            query<HTMLElement>(".survey-menu-button"),
                        ],
                        intro: query<HTMLElement>(".survey-intro"),
                        controls: query<HTMLElement>(".survey-controls"),
                        obstacles: [
                            query<HTMLElement>(".survey-logo"),
                            query<HTMLElement>(".survey-nav"),
                            query<HTMLElement>(".survey-menu-button"),
                            query<HTMLElement>(".survey-intro"),
                            query<HTMLElement>(".survey-controls"),
                        ],
                    },
                })
            }

            loadScene()
                .then((scene) => wireSurveyControls(scene))
                .catch((error) => {
                    // Sin WebGL o sin datos: los apartados se quedan como una
                    // lista normal y la página sigue siendo usable.
                    console.error(error)
                    document.documentElement.classList.add("survey-failed")
                })
        </script>

        <style is:global>
            /* Sin "tirar para recargar" ni rebote: al arrastrar el dedo por la
               sierra (la lupa lo sigue) el navegador recargaba la página. */
            html:has(.survey) {
                overscroll-behavior: none;
            }

            .survey {
                --mono: var(--font-mono);
                min-height: 100vh;
                min-height: 100dvh;
                overscroll-behavior: none;
                overflow: hidden;
                background: var(--color-bg-primary);
                color: var(--color-text-primary);
                cursor: crosshair;
            }

            .survey a,
            .survey button {
                cursor: pointer;
            }

            /* dvh descuenta las barras del navegador en móvil: con vh el lienzo
               quedaba estirado al aparecer o esconderse la barra de Safari. */
            .survey-canvas {
                position: fixed;
                inset: 0;
                width: 100vw;
                height: 100vh;
                height: 100dvh;
                display: block;
                /* Un dedo gira la sierra; dos siguen ampliando la página
                   (con touch-action: none no se podía hacer zoom, WCAG 1.4.4). */
                touch-action: pinch-zoom;
                cursor: grab;
            }

            .is-orbiting .survey-canvas {
                cursor: grabbing;
            }

            /* Menú hamburguesa y desplegable «Qué hago»: solo en pantallas
               pequeñas (bloque "compacto", al final). */
            .survey-menu-button,
            .survey-more {
                display: none;
            }

            /* --- Cabecera y lectura de coordenadas --- */
            .survey-header {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 20;
                display: grid;
                grid-template-columns: auto 1fr auto;
                align-items: start;
                gap: 1rem;
                padding: 1.75rem clamp(1.25rem, 4vw, 3rem);
                pointer-events: none;
            }

            .survey-logo {
                pointer-events: auto;
                font-family: var(--font-heading);
                font-size: 1.875rem;
                line-height: 1;
                color: var(--color-text-primary);
                border-radius: 4px;
            }

            /* Cápsula casi opaca: la navegación puede quedar sobre curvas doradas
               o nevadas y su contraste no puede depender de lo que haya debajo. */
            .survey-nav {
                justify-self: center;
                display: flex;
                gap: 0.25rem;
                padding: 0.15rem;
                border-radius: 999px;
                background: rgba(11, 15, 20, 0.86);
                border: 1px solid rgba(232, 200, 114, 0.12);
                pointer-events: auto;
            }

            .survey-nav a {
                display: inline-flex;
                align-items: center;
                min-height: 36px;
                padding: 0 0.6rem;
                border-radius: 999px;
                font-size: 0.75rem;
                font-weight: 500;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                color: var(--color-text-primary);
                transition: color 0.2s;
            }

            .survey-nav a:hover {
                color: var(--color-accent);
            }

            /* --- Sonido --- */
            .survey-sound-icon {
                width: 1.15rem;
                height: 0.95rem;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.5;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            .survey-sound-icon .speaker {
                fill: currentColor;
                stroke: none;
            }

            [data-sound][aria-pressed="false"] .waves,
            [data-sound][aria-pressed="true"] .mute {
                display: none;
            }

            [data-sound][aria-pressed="true"] {
                border-color: var(--color-accent);
                color: var(--color-accent);
            }

            /* --- Girar --- */
            .survey-orbit {
                display: flex;
                gap: 0.5rem;
            }

            /* Sin escena (sin JavaScript o sin WebGL) no hay nada que girar; mientras
               carga, los botones guardan su sitio para no mover la fila. */
            html:not(.js) .survey-orbit,
            .survey-failed .survey-orbit {
                display: none;
            }

            .js:not(.survey-ready):not(.survey-failed) .survey-orbit {
                visibility: hidden;
            }

            .survey-button.survey-button--icon {
                width: 44px;
                padding: 0;
                justify-content: center;
            }

            .survey-rotate-icon {
                flex-shrink: 0;
                width: 1.35rem;
                height: 1.35rem;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.6;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            .survey-rotate-icon--right {
                transform: scaleX(-1);
            }

            /* --- Pausa --- */
            .survey-pause-icon {
                width: 0.7rem;
                height: 0.75rem;
                border-left: 2.5px solid currentColor;
                border-right: 2.5px solid currentColor;
            }

            [data-pause][aria-pressed="true"] .survey-pause-icon {
                width: 0;
                height: 0;
                border-style: solid;
                border-color: transparent transparent transparent currentColor;
                border-width: 0.4rem 0 0.4rem 0.7rem;
            }

            /* --- Titular --- */
            .survey-main {
                position: relative;
                z-index: 10;
                min-height: 100vh;
                pointer-events: none;
            }

            .survey-intro {
                position: fixed;
                left: clamp(1.25rem, 4vw, 3rem);
                bottom: clamp(5.5rem, 12vh, 7.5rem);
                max-width: min(44rem, 92vw);
                pointer-events: none;
            }

            /* Sombra que separa el titular de las curvas sin taparlas. De día
               las laderas al sol son más claras y, al girar la sierra, puede
               pasar cualquiera por detrás: es algo más densa que cuando la
               escena era siempre oscura, para que el subtítulo no baje de 4,5:1. */
            .survey-intro::before {
                content: "";
                position: absolute;
                inset: -30% -35% -40% -30%;
                z-index: -1;
                background: radial-gradient(
                    ellipse at 35% 60%,
                    rgba(11, 15, 20, 0.9) 0%,
                    rgba(11, 15, 20, 0.66) 40%,
                    transparent 72%
                );
            }

            .survey-eyebrow {
                font-size: 0.72rem;
                font-weight: 500;
                letter-spacing: 0.3em;
                text-transform: uppercase;
                color: var(--color-accent);
                margin-bottom: 1.25rem;
            }

            .survey-title {
                font-family: var(--font-heading);
                font-weight: 400;
                font-size: clamp(2.6rem, min(8.2vw, 12vh), 8.5rem);
                line-height: 0.95;
                letter-spacing: -0.01em;
                text-shadow: 0 2px 40px rgba(11, 15, 20, 0.9);
            }

            .survey-title em {
                font-style: italic;
                color: var(--color-accent);
            }

            .survey-subtitle {
                margin-top: 1.5rem;
                font-size: clamp(1rem, 1.3vw, 1.2rem);
                color: var(--color-text-secondary);
                max-width: 32rem;
                text-shadow: 0 1px 16px rgba(11, 15, 20, 0.95);
            }

            /* La pista y los créditos son letra pequeña sobre curvas doradas que
               se mueven: llevan su propio fondo, como las tarjetas y los
               botones, para no depender de lo que pase por detrás (WCAG 1.4.3). */
            .survey-hint,
            .survey-caption {
                width: fit-content;
                max-width: 100%;
                padding: 0.15rem 0.5rem;
                margin-left: -0.5rem;
                border-radius: 4px;
                background: rgb(11 15 20 / 0.9);
            }

            .survey-hint {
                margin-top: 0.75rem;
                font-family: var(--mono);
                font-size: 0.72rem;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: var(--color-text-secondary);
            }

            /* Bajo el titular, en pequeño: arriba se cruzaba con las tarjetas de
               los vértices y abajo a la izquierda tapaba el Pontón Alto. */
            .survey-caption {
                margin-top: 0.6rem;
                max-width: 30rem;
                font-family: var(--mono);
                font-size: 0.62rem;
                line-height: 1.5;
                letter-spacing: 0.06em;
                color: var(--color-text-secondary);
            }

            /* --- Controles --- */
            .survey-controls {
                position: fixed;
                right: clamp(1.25rem, 4vw, 3rem);
                bottom: 1.5rem;
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: flex-end;
                gap: 0.75rem;
                pointer-events: auto;
            }

            .survey-button {
                display: inline-flex;
                align-items: center;
                gap: 0.6rem;
                min-height: 44px;
                padding: 0.7rem 1.25rem;
                border-radius: 999px;
                font-size: 0.875rem;
                font-weight: 500;
                background: var(--color-accent);
                color: var(--color-bg-primary);
                border: 1px solid var(--color-accent);
                transition: background-color 0.2s, color 0.2s;
            }

            [data-pause][aria-pressed="true"] {
                border-color: var(--color-accent);
                color: var(--color-accent);
            }

            .survey-button[aria-pressed="true"] {
                background: transparent;
                color: var(--color-accent);
            }

            .survey-button--ghost {
                background: rgba(11, 15, 20, 0.85);
                color: var(--color-text-primary);
                border-color: rgba(232, 200, 114, 0.25);
                -webkit-backdrop-filter: blur(8px);
                backdrop-filter: blur(8px);
            }

            .survey-button:hover {
                background: var(--color-accent-hover);
                color: var(--color-bg-primary);
            }

            /* Fin del mundo: el botón principal, con un meteorito por icono. */
            .survey-button--doom {
                text-decoration: none;
            }

            .survey-doom-icon {
                width: 1.05rem;
                height: 1.05rem;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.6;
                stroke-linecap: round;
            }

            .survey-doom-icon circle {
                fill: currentColor;
                stroke: none;
            }

            @media (prefers-reduced-motion: no-preference) {
                .survey-button--doom:hover .survey-doom-icon {
                    animation: doom-wobble 0.5s ease-in-out infinite alternate;
                }
            }

            @keyframes doom-wobble {
                from { translate: 0 0; }
                to { translate: -2px 2px; }
            }

            /* El halo oscuro bajo el anillo blanco lo mantiene visible también
               sobre la bruma clara del cielo de día. */
            .survey a:focus-visible,
            .survey button:focus-visible {
                outline: 2px solid #fff;
                outline-offset: 4px;
                box-shadow: 0 0 0 8px rgb(11 15 20 / 0.85);
            }

            /* --- Vértices geodésicos --- */
            .survey-vertices ul {
                position: fixed;
                top: 6rem;
                right: clamp(1.25rem, 4vw, 3rem);
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                pointer-events: auto;
            }

            .survey-ready .survey-vertices ul {
                position: static;
            }

            .survey-ready .vertex {
                position: fixed;
                top: 0;
                left: 0;
                width: 0;
                height: 0;
                will-change: transform;
                animation: vertex-in 0.9s 2.3s both;
            }

            .vertex {
                display: block;
                color: var(--color-text-primary);
            }

            .vertex-pin {
                position: absolute;
                left: -8px;
                top: -10px;
                width: 16px;
                height: 14px;
                overflow: visible;
            }

            .vertex-pin path {
                fill: rgba(11, 15, 20, 0.85);
                stroke: var(--color-accent);
                stroke-width: 1.4;
            }

            .vertex-pin circle {
                fill: var(--color-accent);
            }

            .vertex-stem {
                position: absolute;
                left: 0;
                bottom: 12px;
                width: 1px;
                height: 52px;
                background: rgba(232, 200, 114, 0.7);
            }

            /* Con la escena activa, la posición de la tarjeta y el largo del
               tallo los calcula survey/layout.ts para que nada se pise. */
            .survey-ready .vertex-stem {
                top: var(--stem-top, -64px);
                bottom: auto;
                height: var(--stem-height, 52px);
            }

            .vertex-card {
                position: absolute;
                left: -0.75rem;
                bottom: 66px;
                display: flex;
                flex-direction: column;
                gap: 0.3rem;
                padding: 0.6rem 0.8rem;
                white-space: nowrap;
                border-radius: 6px;
                /* Opaco de sobra: con nieve detrás, a 0.55 la descripción bajaba
                   de 4.5:1 (WCAG 1.4.3). El desenfoque mantiene el cristal. */
                background: rgba(11, 15, 20, 0.85);
                border: 1px solid rgba(232, 200, 114, 0.12);
                -webkit-backdrop-filter: blur(6px);
                backdrop-filter: blur(6px);
                transition: border-color 0.25s, background-color 0.25s, transform 0.25s;
            }

            .survey-ready .vertex-card {
                left: var(--card-x, -0.75rem);
                top: var(--card-y, -130px);
                bottom: auto;
            }

            .js:not(.survey-ready):not(.survey-failed) .survey-vertices {
                visibility: hidden;
            }

            html:not(.survey-ready) .vertex-pin,
            html:not(.survey-ready) .vertex-stem {
                display: none;
            }

            html:not(.survey-ready) .vertex-card {
                position: static;
            }

            .vertex-label {
                font-family: var(--font-heading);
                font-size: 1.6rem;
                line-height: 1;
                color: var(--color-text-primary);
            }

            .vertex-summary {
                font-size: 0.75rem;
                color: var(--color-text-secondary);
            }

            .vertex:hover .vertex-card,
            .vertex:focus-visible .vertex-card {
                border-color: var(--color-accent);
                background: rgba(11, 15, 20, 0.92);
                transform: translateY(-4px);
            }

            .vertex:hover .vertex-label,
            .vertex:focus-visible .vertex-label {
                color: var(--color-accent);
            }

            .survey .vertex:focus-visible {
                outline: none;
                box-shadow: none;
            }

            .survey .vertex:focus-visible .vertex-card {
                outline: 2px solid #fff;
                outline-offset: 4px;
                box-shadow: 0 0 0 8px rgb(11 15 20 / 0.85);
            }

            /* --- Retícula de taquímetro --- */
            .survey-reticle {
                position: fixed;
                top: 0;
                left: 0;
                z-index: 30;
                pointer-events: none;
                will-change: transform;
                opacity: 0;
                transition: opacity 0.3s;
            }

            .pointer-active .survey-reticle {
                opacity: 1;
            }

            .reticle-off .survey-reticle {
                opacity: 0;
            }

            .reticle-ring {
                position: absolute;
                left: -22px;
                top: -22px;
                width: 44px;
                height: 44px;
                border-radius: 50%;
                border: 1px solid rgba(232, 200, 114, 0.55);
                transition: opacity 0.3s;
            }

            .reticle-cross {
                position: absolute;
                left: -34px;
                top: -34px;
                width: 68px;
                height: 68px;
                background:
                    linear-gradient(var(--color-accent), var(--color-accent)) center top / 1px 14px no-repeat,
                    linear-gradient(var(--color-accent), var(--color-accent)) center bottom / 1px 14px no-repeat,
                    linear-gradient(var(--color-accent), var(--color-accent)) left center / 14px 1px no-repeat,
                    linear-gradient(var(--color-accent), var(--color-accent)) right center / 14px 1px no-repeat;
                opacity: 0.7;
                transition: opacity 0.3s;
            }

            @media (pointer: coarse) {
                .survey-reticle {
                    display: none;
                }
            }

            .survey-fade {
                position: fixed;
                inset: 0;
                z-index: 40;
                background: var(--color-bg-primary);
                opacity: 0;
                pointer-events: none;
            }

            /* --- Fin del mundo (survey/controls.ts) ---
               El cielo enrojece mientras cae el meteorito, un único fogonazo en
               el impacto (nunca más de uno: WCAG 2.3.1) y la interfaz sale
               volando. Las piezas usan translate y rotate sueltos, no
               transform: así no chocan con la posición que la escena da a las
               tarjetas de los vértices en cada fotograma. */
            .survey-doom-sky {
                position: fixed;
                inset: 0;
                z-index: 5;
                pointer-events: none;
                opacity: 0;
                background:
                    radial-gradient(circle at 88% -12%, rgba(255, 150, 70, 0.55), rgba(190, 60, 20, 0.22) 38%, transparent 70%),
                    linear-gradient(to bottom, rgba(120, 30, 10, 0.35), transparent 60%);
                mix-blend-mode: screen;
            }

            .doom-launch .survey-doom-sky {
                opacity: 1;
                transition: opacity var(--doom-approach, 1.4s) ease-in;
            }

            .survey-flash {
                position: fixed;
                inset: 0;
                z-index: 45;
                pointer-events: none;
                opacity: 0;
                background: radial-gradient(circle at 50% 45%, #fff6e0, #ffd9a0 55%, #ff9a50);
            }

            .doom-impact .survey-flash {
                animation: doom-flash 0.9s ease-out both;
            }

            .is-doomed .survey-controls,
            .is-doomed .survey-vertices,
            .is-doomed .survey-header {
                pointer-events: none;
            }

            .is-doomed .survey-reticle,
            .survey-menu-open .survey-reticle,
            .survey-sheet-open .survey-reticle {
                opacity: 0;
            }

            /* --- Hoja «Qué hago» (solo se abre en pantallas pequeñas) --- */
            .survey-sheet {
                position: fixed;
                inset: auto 0 0;
                width: min(100%, 36rem);
                max-width: 100%;
                max-height: min(85dvh, 40rem);
                margin: 0 auto;
                padding: 1rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
                overflow-y: auto;
                overscroll-behavior: contain;
                border: 0;
                border-top: 1px solid var(--color-border-hover);
                border-radius: 1.25rem 1.25rem 0 0;
                background: var(--color-bg-surface);
                color: var(--color-text-primary);
                cursor: auto;
            }

            .survey-sheet::backdrop {
                background: rgb(11 15 20 / 0.6);
            }

            @media (prefers-reduced-motion: no-preference) {
                .survey-sheet[open] {
                    animation: sheet-in 0.35s cubic-bezier(0.22, 1, 0.36, 1);
                }
                .survey-sheet[open]::backdrop {
                    animation: backdrop-in 0.35s ease-out;
                }
            }

            @keyframes sheet-in {
                from { transform: translateY(100%); }
            }

            @keyframes backdrop-in {
                from { opacity: 0; }
            }

            .survey-sheet-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 0.75rem;
            }

            .survey-sheet-title {
                font-size: 0.72rem;
                font-weight: 500;
                letter-spacing: 0.24em;
                text-transform: uppercase;
                color: var(--color-accent);
            }

            .survey-sheet-close {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 44px;
                height: 44px;
                margin-right: -0.5rem;
                border-radius: 999px;
                color: var(--color-text-primary);
                transition: color 0.2s;
            }

            .survey-sheet-close:hover {
                color: var(--color-accent);
            }

            .survey-sheet-close svg {
                width: 1.1rem;
                height: 1.1rem;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.6;
                stroke-linecap: round;
            }

            .survey-sheet-lead {
                font-size: 1rem;
                line-height: 1.55;
                color: var(--color-text-secondary);
            }

            .survey-sheet-list {
                margin-top: 1.25rem;
                border-bottom: 1px solid var(--color-border);
            }

            .survey-sheet-link {
                display: grid;
                grid-template-columns: 1fr auto;
                align-items: center;
                column-gap: 1rem;
                padding: 0.85rem 0;
                border-top: 1px solid var(--color-border);
                color: var(--color-text-primary);
            }

            .survey-sheet-label {
                font-family: var(--font-heading);
                font-size: 1.4rem;
                line-height: 1.15;
            }

            .survey-sheet-summary {
                grid-column: 1;
                font-size: 0.85rem;
                color: var(--color-text-secondary);
            }

            .survey-sheet-arrow {
                grid-column: 2;
                grid-row: 1 / span 2;
                color: var(--color-accent);
                transition: translate 0.2s;
            }

            .survey-sheet-link:hover .survey-sheet-label {
                color: var(--color-accent);
            }

            .survey-sheet-link:hover .survey-sheet-arrow {
                translate: 3px 0;
            }

            .survey-sheet-hint,
            .survey-sheet-credits {
                margin-top: 1rem;
                font-family: var(--mono);
                font-size: 0.68rem;
                color: var(--color-text-secondary);
            }

            .survey-sheet-hint {
                letter-spacing: 0.12em;
                text-transform: uppercase;
            }

            .survey-sheet-credits {
                margin-top: 0.5rem;
                letter-spacing: 0.06em;
            }

            .survey .survey-sheet a:focus-visible,
            .survey .survey-sheet button:focus-visible {
                outline-offset: 2px;
            }

            .debris-word {
                display: inline-block;
            }

            .survey .is-debris {
                animation: debris-fall 1.5s cubic-bezier(0.55, 0, 0.9, 0.45) var(--debris-delay, 0s) both !important;
            }

            @keyframes doom-flash {
                0% { opacity: 0; }
                7% { opacity: 0.8; }
                100% { opacity: 0; }
            }

            @keyframes debris-fall {
                0% { translate: 0 0; rotate: 0deg; }
                14% { translate: calc(var(--debris-x, 0px) * 0.2) -28px; rotate: calc(var(--debris-rot, 0deg) * 0.15); }
                100% { translate: var(--debris-x, 0px) 115vh; rotate: var(--debris-rot, 0deg); }
            }

            /* --- Entrada --- */
            @media (prefers-reduced-motion: no-preference) {
                .survey-eyebrow,
                .survey-subtitle,
                .survey-hint {
                    animation: rise-in 1s cubic-bezier(0.22, 1, 0.36, 1) both;
                }
                /* El titular es el elemento más grande de la primera pantalla
                   (LCP): entra visible desde el primer instante, solo se desliza. */
                .survey-title {
                    animation: slide-in 1s cubic-bezier(0.22, 1, 0.36, 1) both;
                }
                .survey-eyebrow { animation-delay: 0.2s; }
                .survey-subtitle { animation-delay: 1.4s; }
                .survey-hint { animation-delay: 2.6s; }
            }

            @media (prefers-reduced-motion: reduce) {
                .survey-ready .vertex {
                    animation: none;
                }
            }

            @keyframes slide-in {
                from { transform: translateY(18px); }
                to { transform: none; }
            }

            @keyframes rise-in {
                from { opacity: 0; transform: translateY(24px); }
                to { opacity: 1; transform: none; }
            }

            @keyframes vertex-in {
                from { opacity: 0; }
                to { opacity: 1; }
            }

            /* --- Móvil --- */
            @media (max-width: 767px) {
                .survey-header {
                    padding: 1rem;
                }
                .survey-eyebrow {
                    font-size: 0.68rem;
                    letter-spacing: 0.16em;
                    margin-bottom: 0.6rem;
                }
                .survey-intro {
                    right: 1rem;
                    max-width: none;
                }
                /* El titular va solo, sobre una sombra que sube desde abajo a
                   todo lo ancho y se ajusta a su altura (--survey-intro-h, la
                   mide el script). En horizontal sigue la sombra redonda. */
                .survey-intro::before {
                    display: none;
                }
                .survey-main::before {
                    content: "";
                    position: fixed;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    height: calc(var(--survey-intro-h, 12rem) + var(--survey-controls-h, 3rem) + 5.5rem);
                    background: linear-gradient(
                        to top,
                        rgb(11 15 20 / 0.94) 0%,
                        rgb(11 15 20 / 0.88) calc(100% - 4.5rem),
                        rgb(11 15 20 / 0) 100%
                    );
                    pointer-events: none;
                    transition: opacity 0.6s;
                }
                .is-doomed .survey-main::before {
                    opacity: 0;
                }
                .survey-title {
                    font-size: clamp(2.3rem, 11.5vw, 3.2rem);
                }
                .survey-subtitle {
                    margin-top: 0.75rem;
                    font-size: 0.95rem;
                }
                .survey-hint {
                    margin-top: 0.6rem;
                }
                .vertex-label {
                    font-size: 1.05rem;
                }
                .vertex-stem {
                    height: 26px;
                }
                /* Ancho propio: posicionada en absoluto sobre un punto, la
                   tarjeta se encogía hasta su palabra más larga y la pregunta
                   salía en cuatro líneas que chocaban con la cabecera. */
                .vertex-card {
                    bottom: 40px;
                    gap: 0.15rem;
                    padding: 0.35rem 0.55rem;
                    width: max-content;
                    max-width: 9.5rem;
                }
                .vertex-summary {
                    font-size: 0.68rem;
                    white-space: normal;
                }
            }

            /* --- Móvil en horizontal y pantallas bajas: titular a la izquierda,
                   controles en una fila y la sierra a la derecha --- */
            @media (orientation: landscape) and (max-height: 560px) {
                .survey-header {
                    padding: 0.75rem 1rem;
                }
                .survey-intro {
                    max-width: 42vw;
                }
                .survey-eyebrow {
                    font-size: 0.68rem;
                    letter-spacing: 0.12em;
                    margin-bottom: 0.4rem;
                }
                .survey-title {
                    font-size: clamp(1.7rem, 8vh, 2.4rem);
                }
                .survey-subtitle {
                    margin-top: 0.5rem;
                    font-size: 0.85rem;
                }
                .js .survey .survey-more {
                    margin-top: 0.5rem;
                }
                .survey-button {
                    min-height: 40px;
                }
                .survey .survey-button--ghost {
                    width: 40px;
                }
                .vertex-label {
                    font-size: 1rem;
                }
                .vertex-card {
                    padding: 0.3rem 0.5rem;
                }
            }

            /* --- Pantallas pequeñas (móvil en vertical y en horizontal) ---
               La sierra manda: el titular va solo, abajo, y lo demás se pliega
               (survey/compact-ui.ts). Sin JavaScript no se pliega nada y la
               navegación se queda en su cápsula, que también cabe. */
            @media (max-width: 767px), (orientation: landscape) and (max-height: 560px) {
                .survey-header {
                    grid-template-columns: auto 1fr auto;
                    align-items: center;
                }

                /* En vertical la cámara mira en picado y arriba solo queda la
                   bruma clara del horizonte: el logo lleva su propia cápsula,
                   a juego con el botón de menú. */
                .survey-logo {
                    display: inline-flex;
                    align-items: center;
                    min-height: 44px;
                    padding: 0 0.85rem;
                    border-radius: 999px;
                    background: rgb(11 15 20 / 0.86);
                    border: 1px solid rgba(232, 200, 114, 0.2);
                    font-size: 1.5rem;
                }

                /* Botón de menú: tres rayas que se cruzan en aspa al abrir. */
                .js .survey-menu-button {
                    grid-column: 3;
                    position: relative;
                    z-index: 2;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 44px;
                    height: 44px;
                    border-radius: 999px;
                    background: rgb(11 15 20 / 0.86);
                    border: 1px solid rgba(232, 200, 114, 0.2);
                    color: var(--color-text-primary);
                    pointer-events: auto;
                }

                .survey-menu-lines {
                    position: relative;
                    display: block;
                    width: 18px;
                    height: 12px;
                }

                .survey-menu-lines::before,
                .survey-menu-lines::after,
                .survey-menu-lines > span {
                    content: "";
                    position: absolute;
                    left: 0;
                    right: 0;
                    display: block;
                    height: 1.5px;
                    border-radius: 1px;
                    background: currentColor;
                    transition: top 0.25s, transform 0.25s, opacity 0.2s;
                }

                .survey-menu-lines::before {
                    top: 0;
                }

                .survey-menu-lines > span {
                    top: calc(50% - 0.75px);
                }

                .survey-menu-lines::after {
                    top: calc(100% - 1.5px);
                }

                .survey-menu-open .survey-menu-lines::before,
                .survey-menu-open .survey-menu-lines::after {
                    top: calc(50% - 0.75px);
                }

                .survey-menu-open .survey-menu-lines::before {
                    transform: rotate(45deg);
                }

                .survey-menu-open .survey-menu-lines::after {
                    transform: rotate(-45deg);
                }

                .survey-menu-open .survey-menu-lines > span {
                    opacity: 0;
                }

                /* Panel del menú a pantalla completa, como el del resto de la
                   web (Header.astro). visibility lo saca del orden de tabulación
                   y del árbol de accesibilidad mientras está cerrado. */
                .js .survey-nav {
                    position: fixed;
                    inset: 0;
                    z-index: 1;
                    /* Hijo de un grid: sin esto, justify-self: center lo
                       encogía a su contenido aun estando fijo a pantalla. */
                    justify-self: stretch;
                    align-self: stretch;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    gap: 1.25rem;
                    padding: 5rem 1.5rem 2rem;
                    overflow-y: auto;
                    border: 0;
                    border-radius: 0;
                    background: rgb(11 15 20 / 0.97);
                    -webkit-backdrop-filter: blur(12px);
                    backdrop-filter: blur(12px);
                    opacity: 0;
                    visibility: hidden;
                    transition: opacity 0.25s, visibility 0s linear 0.25s;
                }

                .survey-menu-open .survey-nav {
                    opacity: 1;
                    visibility: visible;
                    transition: opacity 0.25s;
                }

                .js .survey-nav a {
                    min-height: 44px;
                    padding: 0 1rem;
                    font-family: var(--font-heading);
                    font-size: 1.9rem;
                    font-weight: 400;
                    letter-spacing: 0;
                    text-transform: none;
                }

                .js .survey-nav .survey-language {
                    font-family: var(--font-body);
                    font-size: 0.85rem;
                    font-weight: 600;
                    letter-spacing: 0.12em;
                }

                .js .survey-nav .survey-nav-cta {
                    margin-top: 0.5rem;
                    min-height: 48px;
                    padding: 0 1.75rem;
                    font-family: var(--font-body);
                    font-size: 1rem;
                    font-weight: 500;
                    background: var(--color-accent);
                    color: var(--color-bg-primary);
                }

                .js .survey-nav .survey-nav-cta:hover {
                    background: var(--color-accent-hover);
                    color: var(--color-bg-primary);
                }

                /* Sin JavaScript: la cápsula de siempre, a la derecha y apretada. */
                html:not(.js) .survey-nav {
                    grid-column: 2 / -1;
                    justify-self: end;
                    gap: 0;
                }

                html:not(.js) .survey-nav a {
                    min-height: 32px;
                    padding: 0 0.45rem;
                    font-size: 0.7rem;
                    letter-spacing: 0.06em;
                    white-space: nowrap;
                }

                .survey-intro {
                    left: 1rem;
                    bottom: calc(var(--survey-controls-h, 3rem) + 1.5rem);
                }

                /* «Qué hago»: abre la hoja con el subtítulo, la pista y la
                   pregunta de cada cumbre. */
                .js .survey-more {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.6rem;
                    margin-top: 0.85rem;
                    min-height: 40px;
                    padding: 0 1rem 0 0.9rem;
                    border-radius: 999px;
                    border: 1px solid rgba(232, 200, 114, 0.3);
                    background: rgb(11 15 20 / 0.6);
                    color: var(--color-text-primary);
                    font-size: 0.85rem;
                    font-weight: 500;
                    pointer-events: auto;
                    transition: border-color 0.2s, color 0.2s;
                }

                .js .survey-more:hover {
                    border-color: var(--color-accent);
                    color: var(--color-accent);
                }

                /* Chevrón hacia arriba: la hoja sube desde abajo. */
                .survey-more-icon {
                    width: 0.45rem;
                    height: 0.45rem;
                    border-left: 1.5px solid currentColor;
                    border-top: 1.5px solid currentColor;
                    transform: translateY(2px) rotate(45deg);
                }

                .js .survey-details {
                    display: none;
                }

                /* En el mapa, la pregunta de cada cumbre sale de la vista (está
                   en la hoja) pero sigue en el nombre del enlace para el
                   lector de pantalla. */
                .js .vertex-summary {
                    position: absolute;
                    width: 1px;
                    height: 1px;
                    padding: 0;
                    margin: -1px;
                    overflow: hidden;
                    clip-path: inset(50%);
                    white-space: nowrap;
                    border: 0;
                }

                /* Letra pequeña, pero nunca por debajo de ~11 px. */
                .survey-hint,
                .survey-caption {
                    font-size: 0.68rem;
                }

                /* Las fuentes, en una sola línea desde 360 px. */
                .survey-caption {
                    margin-top: 0.75rem;
                    letter-spacing: 0.02em;
                }

                .js .survey-caption-place {
                    display: none;
                }

                /* Controles en una fila: girar, pausa y sonido como iconos (su
                   nombre sigue ahí para el lector de pantalla) y el fin del
                   mundo, con su texto, a la derecha. */
                .survey-controls {
                    left: 1rem;
                    right: 1rem;
                    bottom: 1rem;
                    display: flex;
                    flex-wrap: wrap;
                    justify-content: flex-start;
                    gap: 0.4rem;
                }

                .survey-orbit {
                    gap: 0.4rem;
                }

                .survey-button--ghost {
                    width: 44px;
                    padding: 0;
                    justify-content: center;
                }

                .survey-button-text {
                    position: absolute;
                    width: 1px;
                    height: 1px;
                    padding: 0;
                    margin: -1px;
                    overflow: hidden;
                    clip-path: inset(50%);
                    white-space: nowrap;
                    border: 0;
                }

                .survey-button--doom {
                    margin-left: auto;
                    padding: 0.6rem 1rem;
                    font-size: 0.85rem;
                }
            }

            /* Móviles estrechos: el fin del mundo se queda sin icono y los
               controles se aprietan para no partir la fila, que robaba alto a
               la sierra. */
            @media (max-width: 374px) {
                .survey-doom-icon {
                    display: none;
                }
                .survey .survey-controls,
                .survey .survey-orbit {
                    gap: 0.3rem;
                }
                .survey .survey-button--ghost {
                    width: 38px;
                    min-height: 38px;
                }
                .survey .survey-button--doom {
                    min-height: 38px;
                    padding: 0 0.75rem;
                    font-size: 0.8rem;
                }
                .survey-eyebrow {
                    letter-spacing: 0.08em;
                }
                /* Sin JavaScript, mejor que «Versión clásica» pase a dos líneas
                   que cortar «Hablemos». */
                html:not(.js) .survey .survey-nav a {
                    padding: 0 0.35rem;
                    letter-spacing: 0.02em;
                    white-space: normal;
                }
            }

            /* --- Pantallas muy bajas ---
               Con 22rem de alto o menos (zoom al 400 %, ventanas pequeñas), o
               estrechas y de menos de 28rem (zoom al 200 %), la portada no cabe
               entera: pasa a desplazarse. El relieve se queda de fondo y el
               texto, las cumbres y los controles vuelven al flujo normal, en
               ese orden y sin ocultar nada (WCAG 1.4.10). Antes saltaba también
               en móviles normales (hasta 400×700) y tapaba la sierra. */
            @media (max-height: 22rem), (max-width: 767px) and (max-height: 28rem) {
                html:has(.survey),
                .survey {
                    overflow-y: auto;
                }
                /* Arrastrar en vertical vuelve a desplazar la página; en
                   horizontal, gira la sierra. */
                .survey-canvas {
                    touch-action: pan-y pinch-zoom;
                }
                .survey-header {
                    position: absolute;
                }
                .survey-main {
                    min-height: 0;
                    display: flex;
                    flex-direction: column;
                    gap: 1.25rem;
                    padding: 4.5rem 1rem 1.5rem;
                }
                .survey-main::before {
                    display: none;
                }
                .survey .survey-intro {
                    position: relative;
                    left: auto;
                    right: auto;
                    bottom: auto;
                    max-width: 100%;
                    max-height: none;
                    overflow: visible;
                }
                .survey .survey-intro::before {
                    display: block;
                    inset: -0.75rem;
                    border-radius: 0.75rem;
                    background: rgb(11 15 20 / 0.88);
                }
                .survey-ready .survey-vertices ul,
                .survey-vertices ul {
                    position: static;
                    display: flex;
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 0.5rem;
                }
                /* La escena coloca cada cumbre en cada fotograma: aquí manda la lista. */
                .survey-ready .vertex {
                    position: static;
                    width: auto;
                    height: auto;
                    transform: none !important;
                }
                .survey .vertex-card {
                    position: static;
                    white-space: normal;
                }
                .vertex-pin,
                .vertex-stem {
                    display: none;
                }
                .survey .survey-controls {
                    position: static;
                }
            }
        </style>
    </body>
</html>
