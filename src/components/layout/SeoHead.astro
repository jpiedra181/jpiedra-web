---
// Todo lo que va en <head> y es común a las páginas: favicons, título y
// descripción, canonical y hreflang, Open Graph, Twitter, datos estructurados
// y la analítica. Lo usan BaseLayout y la home 3D, que tiene su propio
// documento.
import type { Lang } from "../../types"
import { siteConfig, pairFor, canonicalPath } from "../../config/site"

interface Props {
    lang: Lang
    title?: string
    description?: string
    ogImage?: string
    ogImageAlt?: string
    // Datos estructurados (schema.org) de la página.
    structuredData?: object | object[]
    noindex?: boolean
}

const { lang, title, description, ogImage, ogImageAlt, structuredData, noindex = false } = Astro.props

const pageTitle =
    title ||
    (lang === "es"
        ? "Javier Piedra · La parte difícil de la web"
        : "Javier Piedra · The hard part of the web")

const pageDescription =
    description ||
    (lang === "es"
        ? "Experiencias web 3D, accesibilidad web y webs preparadas para agentes de IA. Diseño y desarrollo de lo que una plantilla no resuelve."
        : "3D web experiences, web accessibility and websites ready for AI agents. Design and development of what a template can’t solve.")

// Canonical y hreflang con la barra final con la que el build sirve cada
// página. Solo se declaran versiones en otro idioma que existen de verdad
// (src/config/page-pairs.json); el blog y el autoevaluador solo están en
// español y no llevan alternativa.
const canonicalUrl = `${siteConfig.url}${canonicalPath(Astro.url.pathname)}`
const pair = pairFor(Astro.url.pathname)
const alternates = pair
    ? [
          { hreflang: "es", href: `${siteConfig.url}${canonicalPath(pair.es)}` },
          { hreflang: "en", href: `${siteConfig.url}${canonicalPath(pair.en)}` },
          { hreflang: "x-default", href: `${siteConfig.url}${canonicalPath(pair.es)}` },
      ]
    : []

const OG_LOCALE = { es: "es_ES", en: "en_GB" } as const
const finalOgImage = ogImage || `${siteConfig.url}/og-default-${lang}.jpg`
const finalOgImageAlt = ogImageAlt || pageTitle
const schemas = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#0B0F14" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="google-site-verification" content="NXHVngJ9aKaRG95Zz8S-JUDRk5cd-4Y0ENlzKwK7GEg" />

<link rel="canonical" href={canonicalUrl} />
{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}

<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{pair && <meta property="og:locale:alternate" content={OG_LOCALE[lang === "es" ? "en" : "es"]} />}
<meta property="og:image" content={finalOgImage} />
<meta property="og:image:secure_url" content={finalOgImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={finalOgImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={finalOgImage} />
<meta name="twitter:image:alt" content={finalOgImageAlt} />

{schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}

