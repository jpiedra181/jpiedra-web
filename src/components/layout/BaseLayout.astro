---
import type { Lang } from "../../types"
import Header from "./Header.astro"
import Footer from "./Footer.astro"
import SeoHead from "./SeoHead.astro"
import "../../styles/global.css"
import serifFont from "../../assets/fonts/newsreader-latin-opsz-400-normal.woff2?url"
import sansFont from "@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url"

interface Props {
    lang: Lang
    title?: string
    description?: string
    ogImage?: string
    ogImageAlt?: string
    structuredData?: object | object[]
    noindex?: boolean
}

const { lang } = Astro.props
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <SeoHead {...Astro.props} />
        <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    </head>
    <body
        class="bg-bg-primary text-text-primary font-body antialiased overflow-x-hidden"
    >
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-3 focus:bg-accent focus:text-bg-primary focus:rounded-full focus:font-body focus:font-medium focus:text-sm focus:shadow-lg focus:outline-2 focus:outline-offset-2 focus:outline-white"
        >
            {lang === "es" ? "Saltar al contenido" : "Skip to content"}
        </a>
        <Header lang={lang} />
        <main id="main-content">
            <slot />
        </main>
        <Footer lang={lang} />

        <script>
            import { initPageTransitions } from "../../scripts/page-transition"

            initPageTransitions()
        </script>
    </body>
</html>
