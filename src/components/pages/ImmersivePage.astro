---
import type { Lang } from "../../types"
import BaseLayout from "../layout/BaseLayout.astro"
import Hero from "../sections/immersive/Hero.astro"
import Problem from "../sections/immersive/Problem.astro"
import Projects from "../sections/Projects.astro"
import Doubts from "../sections/immersive/Doubts.astro"
import Process from "../sections/immersive/Process.astro"
import Faq from "../sections/Faq.astro"
import Contact from "../sections/Contact.astro"
import { useTranslations } from "../../i18n/utils"
import { routesFor } from "../../config/site"
import { breadcrumbSchema, ogImageFor, serviceSchema } from "../../lib/seo-schema"

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const copy = t.immersive
const routes = routesFor(lang)
const structuredData = [
    serviceSchema({
        lang,
        path: routes.immersive,
        name: copy.hero.label,
        description: copy.meta.description,
        serviceType: lang === "es" ? "Desarrollo de experiencias web 3D" : "3D web experience development",
    }),
    breadcrumbSchema([
        { name: "Javier Piedra", path: routes.home },
        { name: copy.hero.label, path: routes.immersive },
    ]),
]
---

<BaseLayout
    lang={lang}
    title={copy.meta.title}
    description={copy.meta.description}
    ogImage={ogImageFor("experiencias-3d", lang)}
    structuredData={structuredData}
>
    <!-- Carta de ventas: el problema, las pruebas, las dudas con su prueba y lo
         práctico antes de pedir presupuesto. -->
    <Hero lang={lang} />
    <Problem lang={lang} />
    <Projects
        lang={lang}
        id="pruebas"
        label={copy.proof.label}
        title={copy.proof.title}
        intro={copy.proof.intro}
        slugs={["veta", "insideTheFrame"]}
        cases={copy.proof.cases}
        problemLabel={copy.proof.problemLabel}
        note={copy.proof.note}
    />
    <Doubts lang={lang} />
    <Process lang={lang} />
    <Faq id="lo-practico" copy={copy.faq} />
    <Contact
        lang={lang}
        title={copy.contact.title}
        subtitle={copy.contact.subtitle}
        summit="penalara"
    />
</BaseLayout>

<script>
    import {
        initScrollAnimations,
        initRevealAnimations,
        initRouteSteps,
        destroyAnimations,
    } from "../../scripts/gsap-animations"
    import { initSpotlights } from "../../scripts/spotlight"

    // El hero se anima con CSS (no espera a este script).
    initScrollAnimations()
    initRevealAnimations()
    initRouteSteps()
    const destroySpotlights = initSpotlights()

    document.addEventListener(
        "astro:before-swap",
        () => {
            destroyAnimations()
            destroySpotlights()
        },
        { once: true },
    )
</script>
