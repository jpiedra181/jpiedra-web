---
//@ts-nocheck
import type { Lang } from "../../../types"
import { useTranslations } from "../../../i18n/utils"
import { laGranjaToPenalara } from "../../../data/contour-maps"
import SectionLabel from "../../ui/SectionLabel.astro"
import ElevationProfile from "../../ui/ElevationProfile.astro"

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const copy = t.home.about

// Dónde cae cada hito del recorrido (fracción de la subida). La cumbre es hoy.
const MILESTONE_POSITIONS = [0.1, 0.36, 0.64, 1]
const milestones = copy.milestones.map((milestone, index) => ({
    ...milestone,
    at: MILESTONE_POSITIONS[index],
}))
---

<section id="about" aria-labelledby="about-title" class="relative pt-24 pb-16 md:pt-32 md:pb-20 lg:pt-40 lg:pb-24 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="grid lg:grid-cols-[5fr_7fr] gap-10 lg:gap-20 items-start">
            <div>
                <div data-wipe>
                    <SectionLabel text={t.about.label} />
                </div>
                <h2
                    id="about-title"
                    data-split
                    class="font-heading text-[clamp(2rem,4vw,3.5rem)] leading-[1.12] text-text-primary"
                >
                    {t.about.title}
                </h2>
            </div>
            <div data-reveal-stagger class="flex flex-col gap-5 md:gap-6 lg:pt-12">
                <p class="text-base md:text-lg text-text-secondary leading-relaxed">{t.about.text_1}</p>
                <p class="text-base md:text-lg text-text-secondary leading-relaxed">{t.about.text_2}</p>
                <p class="text-base md:text-lg text-text-secondary leading-relaxed">{t.about.text_3}</p>
                <a
                    href="#contact"
                    class="self-start mt-2 inline-flex items-center gap-2 text-base font-medium text-accent hover:text-accent-hover underline-offset-4 hover:underline transition-colors duration-200 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                >
                    {t.about.cta}
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>

        <div class="mt-20 md:mt-28 lg:mt-32">
            <h3 data-reveal class="font-heading text-[clamp(1.5rem,2.4vw,2rem)] text-text-primary mb-10 lg:mb-24">
                {copy.profileTitle}
            </h3>
            <ElevationProfile
                profile={laGranjaToPenalara}
                milestones={milestones}
                milestonesLabel={copy.milestonesLabel}
                caption={copy.profileCaption}
                startLabel={copy.start}
            />
        </div>
    </div>
</section>
