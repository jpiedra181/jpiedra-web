---
//@ts-nocheck
import type { Lang } from "../../../types"
import { useTranslations } from "../../../i18n/utils"
import { routesFor } from "../../../config/site"
import { surveyVertices } from "../../../data/survey-vertices"
import { penalaraSummit, sietePicosSummit, bolaDelMundoSummit } from "../../../data/contour-maps"
import SectionLabel from "../../ui/SectionLabel.astro"
import ContourMap from "../../ui/ContourMap.astro"
import { formatElevation } from "../../../lib/format"

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const copy = useTranslations(lang).home.disciplines
const routes = routesFor(lang)

// Cada especialidad cuelga de la misma cumbre que en la home 3D.
const summitMaps = {
    immersive: penalaraSummit,
    accessibility: sietePicosSummit,
    ai: bolaDelMundoSummit,
}
const vertexFor = (key: string) => surveyVertices.find((vertex) => vertex.id === key)
// Altura de la maqueta de cada cumbre, en unidades del plano.
const SUMMIT_LIFT = 26
---

<section
    id="disciplinas"
    aria-labelledby="disciplinas-title"
    class="relative py-24 md:py-32 lg:py-40 bg-bg-surface border-t border-b border-border"
>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
        <div class="max-w-3xl">
            <div data-wipe>
                <SectionLabel text={copy.label} />
            </div>
            <h2
                id="disciplinas-title"
                data-split
                class="font-heading text-[clamp(2rem,4.5vw,4rem)] leading-[1.1] text-text-primary"
            >
                {copy.title}
            </h2>
            <p
                data-reveal
                class="font-body text-[clamp(1rem,1.4vw,1.25rem)] leading-relaxed text-text-secondary mt-6 md:mt-8 max-w-[45rem]"
            >
                {copy.subtitle}
            </p>
        </div>

        <ul role="list" data-reveal-stagger class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mt-16 md:mt-20">
            {
                copy.items.map((item) => {
                    const vertex = vertexFor(item.key)
                    return (
                        <li class="discipline-card flex flex-col bg-bg-primary border border-border rounded-2xl overflow-hidden hover:border-border-hover transition-colors duration-300">
                            <div class="discipline-map">
                                <ContourMap
                                    map={summitMaps[item.key]}
                                    id={`summit-${item.key}`}
                                    lift={SUMMIT_LIFT}
                                    reveal="scroll"
                                />
                                {vertex && (
                                    <p class="discipline-vertex" aria-hidden="true">
                                        <span class="discipline-vertex-code">{vertex.code}</span>
                                        {vertex.peak}
                                        <span class="discipline-vertex-elevation">{formatElevation(vertex.elevation, lang)}</span>
                                    </p>
                                )}
                            </div>
                            <div class="flex flex-col flex-1 p-8 lg:p-10">
                                <h3 class="font-heading text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.15] text-text-primary">
                                    {item.title}
                                </h3>
                                <p class="text-base lg:text-lg text-text-secondary leading-relaxed mt-4 flex-1">
                                    {item.description}
                                </p>
                                <a
                                    href={routes[item.key]}
                                    class="discipline-link mt-10 self-start inline-flex items-center gap-2 text-base font-medium text-accent hover:text-accent-hover underline-offset-4 hover:underline transition-colors duration-200 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white group/link"
                                >
                                    {item.cta}
                                    <span
                                        aria-hidden="true"
                                        class="transition-transform duration-200 group-hover/link:translate-x-1"
                                    >
                                        →
                                    </span>
                                </a>
                            </div>
                        </li>
                    )
                })
            }
        </ul>
    </div>
</section>

<style>
    .discipline-card {
        position: relative;
    }

    /* Toda la tarjeta lleva al enlace: la zona clicable crece sin añadir un
       segundo enlace al orden de tabulación. */
    .discipline-link::after {
        content: "";
        position: absolute;
        inset: 0;
    }

    .discipline-map {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-bottom: 1px solid var(--color-border);
    }

    .discipline-map :global(.contour-map) {
        --area-low: var(--color-bg-primary);
    }

    .discipline-vertex {
        position: absolute;
        left: 1.25rem;
        top: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.375rem 0.75rem;
        border: 1px solid var(--color-border-hover);
        border-radius: 999px;
        background: rgb(11 15 20 / 0.85);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        color: var(--color-text-primary);
    }

    .discipline-vertex-code,
    .discipline-vertex-elevation {
        color: var(--color-accent);
        font-variant-numeric: tabular-nums;
    }

    /* La cartela ya dice qué cumbre es; dentro del plano basta el vértice.
       A este tamaño el rótulo del SVG quedaría diminuto en móvil. */
    .discipline-map :global(.contour-peak text) {
        display: none;
    }

    /* Al pasar el ratón (o al llegar con el teclado) la maqueta se inclina
       hacia atrás, como al mirarla desde más abajo. Se mueve el plano entero:
       la tarjeta gráfica lo gira sin volver a pintarlo. */
    @media (prefers-reduced-motion: no-preference) {
        .discipline-map :global(.contour-map) {
            transform: perspective(900px) rotateX(0deg) scale(1.02);
            transform-origin: 50% 60%;
            transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .discipline-card:hover .discipline-map :global(.contour-map),
        .discipline-card:focus-within .discipline-map :global(.contour-map) {
            transform: perspective(900px) rotateX(32deg) scale(1.16);
        }
    }
</style>
