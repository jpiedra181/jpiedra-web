---
//@ts-nocheck
import { Image } from "astro:assets"
import type { Lang } from "../../../types"
import { useTranslations } from "../../../i18n/utils"
import { routesFor } from "../../../config/site"
import SectionLabel from "../../ui/SectionLabel.astro"
import immersiveImage from "../../../assets/disciplines/immersive.jpg"
import accessibilityImageEs from "../../../assets/disciplines/accessibility-es.jpg"
import accessibilityImageEn from "../../../assets/disciplines/accessibility-en.jpg"

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const copy = useTranslations(lang).home.disciplines
const routes = routesFor(lang)

// Cada especialidad se enseña con su propio trabajo, no con una foto de
// banco: el muestrario de piedra de /experiencias-3d (pulido, mate y
// estructurado bajo la misma luz) y la ficha de /accesibilidad-web vista con
// la lupa del lector de pantalla, en el idioma de la página. Son capturas de
// esas dos páginas; la tarjeta ya lo cuenta en texto, así que van sin alt.
const images = {
    immersive: immersiveImage,
    accessibility: lang === "en" ? accessibilityImageEn : accessibilityImageEs,
}
---

<section
    id="disciplinas"
    aria-labelledby="disciplinas-title"
    class="relative py-24 md:py-32 lg:py-40 bg-bg-surface border-t border-b border-border"
>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
        <div class="max-w-3xl">
            <div data-wipe>
                <SectionLabel text={copy.label} />
            </div>
            <h2
                id="disciplinas-title"
                data-split
                class="font-heading text-[clamp(2rem,4.5vw,4rem)] leading-[1.1] text-text-primary"
            >
                {copy.title}
            </h2>
            <p
                data-reveal
                class="font-body text-[clamp(1rem,1.4vw,1.25rem)] leading-relaxed text-text-secondary mt-6 md:mt-8 max-w-[45rem]"
            >
                {copy.subtitle}
            </p>
        </div>

        <ul role="list" data-reveal-stagger class="grid md:grid-cols-2 gap-6 lg:gap-8 mt-16 md:mt-20">
            {
                copy.items.map((item) => (
                    <li class="discipline-card flex flex-col bg-bg-primary border border-border rounded-2xl overflow-hidden hover:border-border-hover transition-colors duration-300">
                        <div class="discipline-image">
                            <Image
                                src={images[item.key]}
                                alt=""
                                widths={[480, 720, 1100]}
                                sizes="(min-width: 1280px) 600px, (min-width: 768px) 50vw, 100vw"
                                loading="lazy"
                            />
                        </div>
                        <div class="flex flex-col flex-1 p-8 lg:p-10">
                            <h3 class="font-heading text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.15] text-text-primary">
                                {item.title}
                            </h3>
                            <p class="text-base lg:text-lg text-text-secondary leading-relaxed mt-4 flex-1">
                                {item.description}
                            </p>
                            <a
                                href={routes[item.key]}
                                class="discipline-link mt-10 self-start inline-flex items-center gap-2 text-base font-medium text-accent hover:text-accent-hover underline-offset-4 hover:underline transition-colors duration-200 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white group/link"
                            >
                                {item.cta}
                                <span
                                    aria-hidden="true"
                                    class="transition-transform duration-200 group-hover/link:translate-x-1"
                                >
                                    →
                                </span>
                            </a>
                        </div>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    .discipline-card {
        position: relative;
    }

    /* Toda la tarjeta lleva al enlace: la zona clicable crece sin añadir un
       segundo enlace al orden de tabulación. */
    .discipline-link::after {
        content: "";
        position: absolute;
        inset: 0;
    }

    .discipline-image {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-bg-elevated);
    }

    .discipline-image :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Un velo del color de la tarjeta por abajo: la captura se funde con el
       texto en vez de cortarse en seco. */
    .discipline-image::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgb(11 15 20 / 0.55), transparent 45%);
        pointer-events: none;
    }

    @media (prefers-reduced-motion: no-preference) {
        .discipline-image :global(img) {
            transition: scale 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .discipline-card:hover .discipline-image :global(img),
        .discipline-card:focus-within .discipline-image :global(img) {
            scale: 1.05;
        }
    }
</style>
