---
//@ts-nocheck
import type { Lang } from "../../../types"
import { useTranslations } from "../../../i18n/utils"
import SectionLabel from "../../ui/SectionLabel.astro"

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const copy = useTranslations(lang).immersive.difference
const proofs = copy.proofs
// Cada punto lleva su prueba en vivo, en el mismo orden que los textos.
const PROOF_ORDER = ["fps", "keys", "reader", "motion"]
const KEYS = ["ArrowLeft", "ArrowUp", "ArrowDown", "ArrowRight", "Enter", "Escape"]
const KEY_GLYPHS = { ArrowLeft: "←", ArrowUp: "↑", ArrowDown: "↓", ArrowRight: "→", Enter: lang === "en" ? "Enter" : "Intro", Escape: "Esc" }
---

<section id="lo-que-no-se-ve" aria-labelledby="lo-que-no-se-ve-title" class="relative py-24 md:py-32 lg:py-40">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full grid lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-20 items-start">
        <div class="difference-intro">
            <div data-wipe>
                <SectionLabel text={copy.label} />
            </div>
            <h2
                id="lo-que-no-se-ve-title"
                data-split
                class="font-heading text-[clamp(2.25rem,5vw,4.5rem)] leading-[1.05] text-text-primary"
            >
                {copy.title}
            </h2>
            <p
                data-reveal
                class="font-body text-[clamp(1rem,1.4vw,1.25rem)] leading-relaxed text-text-secondary mt-6 md:mt-8 max-w-[34rem]"
            >
                {copy.subtitle}
            </p>
        </div>

        <ul role="list" class="flex flex-col gap-6">
            {
                copy.items.map((item, index) => {
                    const proof = PROOF_ORDER[index]
                    return (
                        <li class="proof" data-proof={proof} data-spotlight data-reveal>
                            <div class="proof-copy">
                                <h3 class="font-heading text-[clamp(1.5rem,2.4vw,2rem)] leading-[1.2] text-text-primary">
                                    {item.title}
                                </h3>
                                <p class="text-base text-text-secondary leading-relaxed mt-3">{item.description}</p>
                            </div>

                            {proof === "fps" && (
                                <p class="proof-fps">
                                    <span class="proof-fps-lead">{proofs.fps.lead}</span>
                                    <span class="proof-fps-number">
                                        <span data-fps-value>{proofs.fps.waiting}</span>
                                        <span class="proof-fps-unit">{proofs.fps.unit}</span>
                                    </span>
                                    <span class="proof-fps-note">{proofs.fps.note}</span>
                                </p>
                            )}

                            {proof === "keys" && (
                                <div class="proof-keys">
                                    <div class="proof-keycaps" aria-hidden="true">
                                        {KEYS.map((key) => (
                                            <kbd class:list={["proof-key", { "is-wide": key.length > 5 && !key.startsWith("Arrow") }]} data-key={key}>
                                                {KEY_GLYPHS[key]}
                                            </kbd>
                                        ))}
                                    </div>
                                    <p class="proof-hint">{proofs.keys.hint}</p>
                                </div>
                            )}

                            {proof === "reader" && (
                                <figure class="proof-reader">
                                    <figcaption>{proofs.reader.label}</figcaption>
                                    <ol role="list" data-reveal-stagger>
                                        {proofs.reader.lines.map((line) => (
                                            <li>{line}</li>
                                        ))}
                                    </ol>
                                </figure>
                            )}

                            {proof === "motion" && (
                                <p class="proof-motion">
                                    <span class="proof-motion-orbit" aria-hidden="true">
                                        <span />
                                    </span>
                                    <span>
                                        {proofs.motion.lead}{" "}
                                        <strong class="when-normal">{proofs.motion.normal}</strong><strong class="when-reduced">{proofs.motion.reduced}</strong>.
                                        <span class="proof-motion-note">{proofs.motion.note}</span>
                                    </span>
                                </p>
                            )}
                        </li>
                    )
                })
            }
        </ul>
    </div>
</section>

<script>
    import { initLiveProofs } from "../../../scripts/live-proofs"

    const section = document.getElementById("lo-que-no-se-ve")
    if (section) {
        const destroy = initLiveProofs(section)
        document.addEventListener("astro:before-swap", destroy, { once: true })
    }
</script>

<style>
    @media (min-width: 64rem) {
        /* El título se queda mientras pasan las pruebas. */
        .difference-intro {
            position: sticky;
            top: 8rem;
        }
    }

    .proof {
        position: relative;
        display: grid;
        gap: 1.75rem;
        padding: 2rem;
        border: 1px solid var(--color-border);
        border-radius: 1rem;
        background: var(--color-bg-surface);
        overflow: hidden;
        isolation: isolate;
    }

    .proof::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: radial-gradient(
            24rem circle at var(--spot-x, 50%) var(--spot-y, 0%),
            rgb(232 200 114 / 0.08),
            transparent 65%
        );
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .proof:hover::before {
        opacity: 1;
    }

    /* fps */
    .proof-fps {
        display: grid;
        gap: 0.25rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
    }

    .proof-fps-lead,
    .proof-fps-note {
        font-size: 0.8125rem;
        letter-spacing: 0.04em;
        color: var(--color-text-secondary);
    }

    .proof-fps-number {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        font-family: var(--font-heading);
        font-size: clamp(3.5rem, 7vw, 5.5rem);
        line-height: 1;
        color: var(--color-accent);
        font-variant-numeric: tabular-nums;
    }

    .proof-fps-unit {
        font-size: 0.35em;
        color: var(--color-text-primary);
    }

    /* Teclado */
    .proof-keys {
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
    }

    .proof-keycaps {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .proof-key {
        display: grid;
        place-items: center;
        min-width: 3rem;
        height: 3rem;
        padding: 0 0.75rem;
        border: 1px solid var(--color-border-hover);
        border-bottom-width: 3px;
        border-radius: 0.5rem;
        background: var(--color-bg-elevated);
        font-family: var(--font-body);
        font-size: 1rem;
        color: var(--color-text-primary);
        transition:
            background-color 0.15s ease,
            color 0.15s ease,
            transform 0.15s ease,
            border-color 0.15s ease;
    }

    .proof-key.is-pressed {
        background: var(--color-accent);
        border-color: var(--color-accent-hover);
        color: var(--color-bg-primary);
        transform: translateY(2px);
    }

    .proof-hint {
        margin-top: 1rem;
        font-size: 0.8125rem;
        color: var(--color-text-secondary);
    }

    /* Lector de pantalla */
    .proof-reader {
        padding: 1.25rem 1.5rem;
        border: 1px solid var(--color-border-hover);
        border-radius: 0.75rem;
        background: var(--color-bg-primary);
    }

    .proof-reader figcaption {
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-accent);
    }

    .proof-reader ol {
        display: grid;
        gap: 0.625rem;
        margin-top: 1rem;
    }

    .proof-reader li {
        position: relative;
        padding-left: 1.25rem;
        font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--color-text-primary);
    }

    .proof-reader li::before {
        content: "›";
        position: absolute;
        left: 0;
        color: var(--color-accent);
    }

    /* Movimiento reducido */
    .proof-motion {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
        font-size: 1rem;
        line-height: 1.5;
        color: var(--color-text-primary);
    }

    .proof-motion strong {
        color: var(--color-accent);
        font-weight: 500;
    }

    .proof-motion-note {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.8125rem;
        color: var(--color-text-secondary);
    }

    .when-reduced,
    .is-reduced .when-normal {
        display: none;
    }

    .is-reduced .when-reduced {
        display: inline;
    }

    .proof-motion-orbit {
        position: relative;
        flex: none;
        width: 3rem;
        height: 3rem;
        border: 1px dashed var(--color-border-hover);
        border-radius: 50%;
    }

    .proof-motion-orbit span {
        position: absolute;
        left: 50%;
        top: -4px;
        width: 8px;
        height: 8px;
        margin-left: -4px;
        border-radius: 50%;
        background: var(--color-accent);
        transform-origin: 4px calc(1.5rem + 4px);
    }

    /* La órbita gira solo si el sistema no pide menos movimiento: es la
       prueba en sí. Gira unos segundos al aparecer y se para (WCAG 2.2.2). */
    @media (prefers-reduced-motion: no-preference) {
        .is-orbiting .proof-motion-orbit span {
            animation: proof-orbit 1.6s linear 3;
        }
    }

    @keyframes proof-orbit {
        to {
            transform: rotate(1turn);
        }
    }

    @media (min-width: 64rem) {
        .proof {
            grid-template-columns: 1fr 0.85fr;
            align-items: center;
            padding: 2.5rem;
        }

        .proof-fps,
        .proof-keys,
        .proof-motion {
            padding-top: 0;
            padding-left: 2rem;
            border-top: 0;
            border-left: 1px solid var(--color-border);
        }
    }
</style>
