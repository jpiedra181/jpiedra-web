---
//@ts-nocheck
import type { Lang } from "../../../types"
import { Image } from "astro:assets"
import { useTranslations } from "../../../i18n/utils"
import { projects } from "../../../data/projects"
import SectionLabel from "../../ui/SectionLabel.astro"
import vetaWithout3d from "../../../assets/immersive/veta-sin-webgl.png"
import insideTheFrameWithout3d from "../../../assets/immersive/inside-the-frame-sin-webgl.png"

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const copy = t.immersive.doubts
const proofs = copy.proofs
// Las fichas solo existen en castellano: desde la versión inglesa se avisa con hreflang.
const sheetHreflang = lang === "es" ? undefined : "es"
const sheets = [
    { name: "VETA", href: projects.veta.accessibilitySheet },
    { name: "Inside the Frame", href: projects.insideTheFrame.accessibilitySheet },
]
const fallbackShots = [
    { src: vetaWithout3d, caption: proofs.fallback.veta },
    { src: insideTheFrameWithout3d, caption: proofs.fallback.insideTheFrame },
]
---

<section id="dudas-3d" aria-labelledby="dudas-3d-title" class="relative py-24 md:py-32 lg:py-40">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full grid lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-20 items-start">
        <div class="doubts-intro">
            <div data-wipe>
                <SectionLabel text={copy.label} />
            </div>
            <h2
                id="dudas-3d-title"
                data-split
                class="font-heading text-[clamp(2.25rem,5vw,4.5rem)] leading-[1.05] text-text-primary"
            >
                {copy.title}
            </h2>
            <p
                data-reveal
                class="font-body text-[clamp(1rem,1.4vw,1.25rem)] leading-relaxed text-text-secondary mt-6 md:mt-8 max-w-[34rem]"
            >
                {copy.subtitle}
            </p>
        </div>

        <ul role="list" class="flex flex-col gap-6">
            {
                copy.items.map((item) => (
                    <li class="doubt" data-proof={item.id} data-spotlight data-reveal>
                        <h3 class="font-heading text-[clamp(1.5rem,2.4vw,2rem)] leading-[1.2] text-text-primary">
                            {item.title}
                        </h3>
                        <p class="text-base text-text-secondary leading-relaxed mt-3">{item.description}</p>

                        {item.id === "speed" && (
                            <figure class="doubt-proof">
                                <figcaption class="doubt-proof-label">{proofs.speed.label}</figcaption>
                                <ul role="list" class="doubt-stats">
                                    {proofs.speed.stats.map((stat) => (
                                        <li>
                                            <strong>{stat.value}</strong>
                                            <span>{stat.label}</span>
                                        </li>
                                    ))}
                                </ul>
                                <p class="doubt-proof-note">{proofs.speed.note}</p>
                            </figure>
                        )}

                        {item.id === "seo" && (
                            <figure class="doubt-proof">
                                <figcaption class="doubt-proof-label">{proofs.seo.label}</figcaption>
                                <div class="serp-result" lang="en">
                                    <p class="serp-url">{proofs.seo.url}</p>
                                    <p class="serp-title">{proofs.seo.title}</p>
                                    <p class="serp-description">{proofs.seo.description}</p>
                                </div>
                                <p class="doubt-proof-note">{proofs.seo.note}</p>
                            </figure>
                        )}

                        {item.id === "reader" && (
                            <figure class="doubt-proof">
                                <figcaption class="doubt-proof-label">{proofs.reader.label}</figcaption>
                                <ol role="list" class="reader-lines">
                                    {proofs.reader.lines.map((line) => (
                                        <li lang={line.lang || undefined}>{line.text}</li>
                                    ))}
                                </ol>
                                <p class="doubt-proof-note">{proofs.reader.note}</p>
                                <p class="doubt-sheets">
                                    {proofs.reader.sheetsLabel}{" "}
                                    {sheets.map((sheet, index) => (
                                        <>
                                            {index > 0 && " · "}
                                            <a href={sheet.href} hreflang={sheetHreflang}>{sheet.name}</a>
                                        </>
                                    ))}
                                </p>
                            </figure>
                        )}

                        {item.id === "fallback" && (
                            <figure class="doubt-proof">
                                <figcaption class="doubt-proof-label">{proofs.fallback.label}</figcaption>
                                <ul role="list" class="fallback-shots">
                                    {fallbackShots.map((shot) => (
                                        <li>
                                            <Image
                                                src={shot.src}
                                                alt=""
                                                widths={[360, 540, 720]}
                                                sizes="(min-width: 1024px) 18rem, (min-width: 640px) 45vw, 100vw"
                                                loading="lazy"
                                                class="fallback-shot"
                                            />
                                            <p>{shot.caption}</p>
                                        </li>
                                    ))}
                                </ul>
                            </figure>
                        )}

                        {item.id === "motion" && (
                            <p class="doubt-motion">
                                <span class="doubt-motion-orbit" aria-hidden="true">
                                    <span />
                                </span>
                                <span>
                                    {proofs.motion.lead}{" "}
                                    <strong class="when-normal">{proofs.motion.normal}</strong><strong class="when-reduced">{proofs.motion.reduced}</strong>.
                                    <span class="doubt-motion-note">{proofs.motion.note}</span>
                                </span>
                            </p>
                        )}
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<script>
    import { initLiveProofs } from "../../../scripts/live-proofs"

    const section = document.getElementById("dudas-3d")
    if (section) {
        const destroy = initLiveProofs(section)
        document.addEventListener("astro:before-swap", destroy, { once: true })
    }
</script>

<style>
    @media (min-width: 64rem) {
        /* El título se queda mientras pasan las dudas. */
        .doubts-intro {
            position: sticky;
            top: 8rem;
        }
    }

    .doubt {
        position: relative;
        padding: 2rem;
        border: 1px solid var(--color-border);
        border-radius: 1rem;
        background: var(--color-bg-surface);
        overflow: hidden;
        isolation: isolate;
    }

    .doubt::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: radial-gradient(
            24rem circle at var(--spot-x, 50%) var(--spot-y, 0%),
            rgb(232 200 114 / 0.08),
            transparent 65%
        );
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .doubt:hover::before {
        opacity: 1;
    }

    .doubt-proof {
        display: grid;
        gap: 0.875rem;
        margin-top: 1.75rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
    }

    .doubt-proof-label {
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-accent);
    }

    .doubt-proof-note {
        font-size: 0.8125rem;
        line-height: 1.5;
        color: var(--color-text-secondary);
    }

    /* Velocidad */
    .doubt-stats {
        display: grid;
        gap: 1rem;
    }

    .doubt-stats li {
        display: grid;
        align-content: start;
        gap: 0.25rem;
    }

    .doubt-stats strong {
        font-family: var(--font-heading);
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 400;
        line-height: 1;
        color: var(--color-accent);
        font-variant-numeric: tabular-nums;
    }

    .doubt-stats span {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
    }

    @media (min-width: 40rem) {
        .doubt-stats {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    /* Google */
    .serp-result {
        padding: 1.25rem 1.5rem;
        border: 1px solid var(--color-border-hover);
        border-radius: 0.75rem;
        background: var(--color-bg-primary);
    }

    .serp-url {
        font-size: 0.8125rem;
        color: var(--color-text-secondary);
    }

    .serp-title {
        margin-top: 0.375rem;
        font-size: 1.125rem;
        line-height: 1.35;
        /* Sin subrayado: no es un enlace y no debe parecerlo. */
        color: var(--color-text-primary);
    }

    .serp-description {
        margin-top: 0.5rem;
        font-size: 0.875rem;
        line-height: 1.55;
        color: var(--color-text-secondary);
    }

    /* Lector de pantalla */
    .reader-lines {
        display: grid;
        gap: 0.625rem;
        padding: 1.25rem 1.5rem;
        border: 1px solid var(--color-border-hover);
        border-radius: 0.75rem;
        background: var(--color-bg-primary);
    }

    .reader-lines li {
        position: relative;
        padding-left: 1.25rem;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--color-text-primary);
    }

    .reader-lines li::before {
        content: "›";
        position: absolute;
        left: 0;
        color: var(--color-accent);
    }

    .doubt-sheets {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
    }

    .doubt-sheets a {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 3px;
        border-radius: 2px;
    }

    .doubt-sheets a:hover {
        color: var(--color-accent-hover);
    }

    .doubt-sheets a:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 3px;
    }

    /* Sin 3D */
    .fallback-shots {
        display: grid;
        gap: 1.25rem;
    }

    .fallback-shots p {
        margin-top: 0.625rem;
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--color-text-secondary);
    }

    .fallback-shot {
        width: 100%;
        height: auto;
        border: 1px solid var(--color-border-hover);
        border-radius: 0.5rem;
    }

    @media (min-width: 40rem) {
        .fallback-shots {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* Movimiento reducido */
    .doubt-motion {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-top: 1.75rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
        font-size: 1rem;
        line-height: 1.5;
        color: var(--color-text-primary);
    }

    .doubt-motion strong {
        color: var(--color-accent);
        font-weight: 500;
    }

    .doubt-motion-note {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.8125rem;
        color: var(--color-text-secondary);
    }

    .when-reduced,
    .is-reduced .when-normal {
        display: none;
    }

    .is-reduced .when-reduced {
        display: inline;
    }

    .doubt-motion-orbit {
        position: relative;
        flex: none;
        width: 3rem;
        height: 3rem;
        border: 1px dashed var(--color-border-hover);
        border-radius: 50%;
    }

    .doubt-motion-orbit span {
        position: absolute;
        left: 50%;
        top: -4px;
        width: 8px;
        height: 8px;
        margin-left: -4px;
        border-radius: 50%;
        background: var(--color-accent);
        transform-origin: 4px calc(1.5rem + 4px);
    }

    /* La órbita gira solo si el sistema no pide menos movimiento: es la
       prueba en sí. Gira unos segundos al aparecer y se para (WCAG 2.2.2). */
    @media (prefers-reduced-motion: no-preference) {
        .is-orbiting .doubt-motion-orbit span {
            animation: doubt-orbit 1.6s linear 3;
        }
    }

    @keyframes doubt-orbit {
        to {
            transform: rotate(1turn);
        }
    }

    @media (min-width: 64rem) {
        .doubt {
            padding: 2.5rem;
        }
    }
</style>
