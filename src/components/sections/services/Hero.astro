---
//@ts-nocheck
import type { Lang } from "../../../types"
import { useTranslations } from "../../../i18n/utils"
import SectionLabel from "../../ui/SectionLabel.astro"

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<section
    id="services-hero"
    class="relative py-24 md:py-32 lg:py-40"
    aria-labelledby="services-hero-title"
>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
        <div class="max-w-3xl">
            <SectionLabel text={t.services.hero.eyebrow} />

            <h1
                id="services-hero-title"
                class="font-heading text-[clamp(2.25rem,5vw,4.5rem)] leading-[1.1] text-text-primary mb-8 md:mb-10"
                style="text-wrap: balance;"
            >
                {t.services.hero.title}{" "}
                <span class="text-accent">{t.services.hero.titleHighlight}</span
                >
            </h1>

            <p
                class="text-base md:text-lg text-text-secondary leading-relaxed max-w-2xl mb-6"
            >
                {t.services.hero.subtitle}
            </p>

            <p class="text-sm text-text-muted">
                {t.services.hero.note}
            </p>
        </div>
    </div>
</section>
