---
//@ts-nocheck
import type { Lang } from "../../../types"
import { useTranslations } from "../../../i18n/utils"
import SectionLabel from "../../ui/SectionLabel.astro"

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<section
    id="services-not-doing"
    class="relative py-24 md:py-32 lg:py-40 border-t border-border"
    aria-labelledby="services-not-doing-title"
>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
        <div class="max-w-3xl">
            <SectionLabel text={t.services.notDoing.eyebrow} />

            <h2
                id="services-not-doing-title"
                class="font-heading text-[clamp(2rem,4vw,3.5rem)] leading-[1.15] text-text-primary mb-8 md:mb-10"
                style="text-wrap: balance;"
            >
                {t.services.notDoing.title}
            </h2>

            <p
                class="text-base md:text-lg text-text-secondary leading-relaxed max-w-2xl mb-12 md:mb-14"
            >
                {t.services.notDoing.subtitle}
            </p>

            <ul class="flex flex-col gap-8 md:gap-10">
                {
                    t.services.notDoing.items.map((item) => (
                        <li>
                            <div class="flex items-baseline gap-4 mb-3">
                                {/* Decorativo: el contenido ya se entiende sin
                                    la marca, y anunciarla en cada punto sería
                                    ruido para el lector de pantalla. */}
                                <span
                                    class="font-heading text-xl md:text-2xl text-accent leading-none"
                                    aria-hidden="true"
                                >
                                    ×
                                </span>
                                <h3 class="font-heading text-2xl md:text-3xl text-text-primary">
                                    {item.title}
                                </h3>
                            </div>
                            <p class="text-base md:text-lg text-text-secondary leading-relaxed max-w-2xl pl-8 md:pl-10">
                                {item.description}
                            </p>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>
