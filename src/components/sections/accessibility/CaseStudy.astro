---
//@ts-nocheck
import type { Lang } from "../../../types"
import { useTranslations } from "../../../i18n/utils"
import SectionLabel from "../../ui/SectionLabel.astro"
import { routesFor } from "../../../config/site"
// El artículo de mi propia auditoría solo existe en castellano.

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const copy = useTranslations(lang).accessibilityLanding.caseStudy
const PROBLEMS = 12
const RING_RADIUS = 52
const RING_LENGTH = 2 * Math.PI * RING_RADIUS
---

<section id="caso-estudio" aria-labelledby="caso-estudio-title" class="relative py-24 md:py-32 lg:py-40">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full grid lg:grid-cols-[1.1fr_0.9fr] gap-14 lg:gap-20 items-center">
        <div class="min-w-0">
            <div data-wipe>
                <SectionLabel text={copy.eyebrow} />
            </div>
            <h2
                id="caso-estudio-title"
                data-split
                class="font-heading text-[clamp(2.25rem,5vw,4.5rem)] leading-[1.05] text-text-primary max-w-[18ch]"
            >
                {copy.title}
            </h2>
            <p data-reveal class="font-body text-[clamp(1rem,1.4vw,1.25rem)] leading-relaxed text-text-secondary mt-6 md:mt-8 max-w-[42rem]">
                {copy.text}
            </p>
            <div data-reveal class="mt-10 md:mt-12">
                <a
                    href="/blog/audite-mi-propia-web/"
                    hreflang={lang === "en" ? "es" : undefined}
                    class="inline-flex items-center gap-2 bg-accent text-bg-primary px-7 py-3.5 rounded-full text-base font-medium hover:bg-accent-hover transition-all duration-300 hover:shadow-lg hover:shadow-accent/20 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white min-h-[44px]"
                >
                    {copy.cta}
                    <span aria-hidden="true">→</span>
                </a>
            </div>
            <p data-reveal class="mt-8 text-base text-text-secondary">
                {copy.caseLead}{" "}
                <a
                    href={routesFor(lang).caseStudy}
                    class="text-accent underline underline-offset-4 decoration-1 hover:text-accent-hover transition-colors rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                >
                    {copy.caseLink}
                </a><span class="text-accent" aria-hidden="true"> →</span>
            </p>
        </div>

        <!-- Lo mismo que cuenta el texto, en grande: el 100 de las herramientas
             automáticas frente a los 12 problemas de la revisión a mano. -->
        <div class="scores" data-scores aria-hidden="true">
            <div class="score score-auto">
                <svg viewBox="0 0 120 120" class="score-ring">
                    <circle cx="60" cy="60" r={RING_RADIUS} class="score-ring-track"></circle>
                    <circle
                        cx="60"
                        cy="60"
                        r={RING_RADIUS}
                        class="score-ring-fill"
                        style={`stroke-dasharray:${RING_LENGTH.toFixed(2)};--ring:${RING_LENGTH.toFixed(2)}`}
                        data-ring
                    ></circle>
                </svg>
                <p class="score-number">
                    <span data-count="100" data-count-decimals="0">{copy.automatedScore}</span>
                    <small>{copy.automatedOf}</small>
                </p>
                <p class="score-label">{copy.automatedLabel}</p>
            </div>

            <div class="score score-manual">
                <p class="score-number score-number-problems">
                    <span data-count={PROBLEMS} data-count-decimals="0">{copy.manualCount}</span>
                    <small>{copy.manualUnit}</small>
                </p>
                <div class="score-marks" data-marks>
                    {Array.from({ length: PROBLEMS }, () => <span />)}
                </div>
                <p class="score-label">{copy.manualLabel}</p>
            </div>
        </div>
    </div>
</section>

<style>
    .scores {
        display: grid;
        gap: 1.25rem;
        min-width: 0;
    }

    .score {
        display: grid;
        gap: 1rem;
        padding: 2rem;
        border: 1px solid var(--color-border);
        border-radius: 1rem;
        background: var(--color-bg-surface);
    }

    .score-auto {
        grid-template-columns: 6.5rem minmax(0, 1fr);
        align-items: center;
        column-gap: 1.5rem;
    }

    .score-auto .score-label {
        grid-column: 1 / -1;
    }

    .score-ring {
        width: 6.5rem;
        height: 6.5rem;
        transform: rotate(-90deg);
    }

    .score-ring-track {
        fill: none;
        stroke: var(--color-bg-elevated);
        stroke-width: 8;
    }

    .score-ring-fill {
        fill: none;
        stroke: #7fd18b;
        stroke-width: 8;
        stroke-linecap: round;
        stroke-dashoffset: 0;
    }

    .score-number {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.625rem;
        font-family: var(--font-heading);
        font-size: clamp(3.5rem, 6vw, 5rem);
        line-height: 1;
        color: var(--color-text-primary);
        font-variant-numeric: tabular-nums;
    }

    .score-number small {
        font-family: var(--font-body);
        font-size: 0.875rem;
        letter-spacing: 0.04em;
        color: var(--color-text-secondary);
    }

    .score-number-problems {
        color: var(--color-accent);
    }

    .score-number-problems small {
        color: var(--color-accent);
    }

    .score-manual {
        border-color: var(--color-border-hover);
        background:
            radial-gradient(30rem 14rem at 0% 0%, rgb(232 200 114 / 0.1), transparent 70%),
            var(--color-bg-surface);
    }

    .score-marks {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 0.4rem;
    }

    .score-marks span {
        height: 1.75rem;
        border-radius: 0.25rem;
        background: var(--color-accent);
    }

    .score-label {
        font-size: 0.8125rem;
        letter-spacing: 0.06em;
        color: var(--color-text-secondary);
    }
</style>
