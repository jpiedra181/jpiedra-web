---
//@ts-nocheck
import type { Lang } from "../../../types"
import { useTranslations } from "../../../i18n/utils"
import { routes } from "../../../config/site"
import SectionLabel from "../../ui/SectionLabel.astro"

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const copy = useTranslations(lang).accessibilityLanding.autoevaluador

// Dial de 7 segmentos, uno por pregunta del autoevaluador.
const QUESTIONS = 7
const RADIUS = 118
const CENTER = 140
const GAP_DEGREES = 7
const point = (degrees: number) => {
    const radians = ((degrees - 90) * Math.PI) / 180
    return `${(CENTER + RADIUS * Math.cos(radians)).toFixed(2)} ${(CENTER + RADIUS * Math.sin(radians)).toFixed(2)}`
}
const segments = Array.from({ length: QUESTIONS }, (_, index) => {
    const span = 360 / QUESTIONS
    const start = index * span + GAP_DEGREES / 2
    const end = (index + 1) * span - GAP_DEGREES / 2
    return `M${point(start)} A${RADIUS} ${RADIUS} 0 0 1 ${point(end)}`
})
---

<section
    id="autoevaluador-cta"
    aria-labelledby="autoevaluador-cta-title"
    class="relative py-20 md:py-28 lg:py-32 bg-bg-surface border-t border-b border-border overflow-hidden"
>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full grid lg:grid-cols-[1.2fr_0.8fr] gap-14 lg:gap-20 items-center">
        <div>
            <div data-wipe>
                <SectionLabel text={copy.eyebrow} />
            </div>
            <h2
                id="autoevaluador-cta-title"
                data-split
                class="font-heading text-[clamp(2.25rem,5vw,4.5rem)] leading-[1.05] text-text-primary max-w-[18ch]"
            >
                {copy.title}
            </h2>
            <p data-reveal class="font-body text-[clamp(1rem,1.4vw,1.25rem)] leading-relaxed text-text-secondary mt-6 md:mt-8 max-w-[42rem]">
                {copy.text}
            </p>
            <div data-reveal class="mt-10 md:mt-12">
                <a
                    href={routes.law}
                    class="inline-flex items-center gap-2 bg-accent text-bg-primary px-7 py-3.5 rounded-full text-base font-medium hover:bg-accent-hover transition-all duration-300 hover:shadow-lg hover:shadow-accent/20 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white min-h-[44px]"
                >
                    {copy.cta}
                    <span aria-hidden="true">→</span>
                </a>
            </div>
            <p data-reveal class="mt-5 text-sm text-text-secondary font-body max-w-[42rem]">{copy.microcopy}</p>
        </div>

        <div class="dial" data-dial aria-hidden="true">
            <svg viewBox="0 0 280 280">
                <circle cx={CENTER} cy={CENTER} r={RADIUS} class="dial-track"></circle>
                {segments.map((d) => <path d={d} class="dial-segment" />)}
            </svg>
            <p class="dial-center">
                <span class="dial-time">{copy.dialTime}</span>
                <span class="dial-label">{copy.dialLabel}</span>
            </p>
        </div>
    </div>
</section>

<style>
    .dial {
        position: relative;
        width: min(100%, 22rem);
        aspect-ratio: 1;
        margin-inline: auto;
    }

    .dial svg {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .dial-track {
        fill: none;
        stroke: var(--color-accent-line);
        stroke-width: 1;
        stroke-dasharray: 2 6;
    }

    .dial-segment {
        fill: none;
        stroke: var(--color-accent);
        stroke-width: 16;
        stroke-linecap: butt;
    }

    .dial-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
    }

    .dial-time {
        font-family: var(--font-heading);
        font-size: clamp(3.5rem, 7vw, 5rem);
        line-height: 1;
        color: var(--color-text-primary);
    }

    .dial-label {
        font-size: 0.75rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-accent);
    }
</style>
