---
//@ts-nocheck
import SectionLabel from "../ui/SectionLabel.astro"

interface FaqItem {
    question: string
    answer: string
    // Enlace opcional al final de la respuesta (una herramienta, otra página).
    linkText?: string
    linkHref?: string
}

interface Props {
    id: string
    copy: { label: string; title: string; items: FaqItem[] }
}

const { id, copy } = Astro.props

// Las preguntas también como FAQPage para buscadores y agentes.
const schema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: copy.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
}
---

<section id={id} aria-labelledby={`${id}-title`} class="relative py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-20 items-start">
        <div class="faq-intro">
            <div data-wipe>
                <SectionLabel text={copy.label} />
            </div>
            <h2
                id={`${id}-title`}
                data-split
                class="font-heading text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1.05] text-text-primary"
            >
                {copy.title}
            </h2>
        </div>

        <!-- <details> nativo: se abre con teclado y lector de pantalla sin JS. -->
        <div class="faq-list" data-reveal-stagger>
            {
                copy.items.map((item) => (
                    <details class="faq-item">
                        <summary>
                            <span>{item.question}</span>
                            <span class="faq-icon" aria-hidden="true" />
                        </summary>
                        <p>
                            {item.answer}
                            {item.linkHref && (
                                <>
                                    {" "}
                                    <a href={item.linkHref}>{item.linkText} →</a>
                                </>
                            )}
                        </p>
                    </details>
                ))
            }
        </div>
    </div>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
    @media (min-width: 64rem) {
        .faq-intro {
            position: sticky;
            top: 8rem;
        }
    }

    .faq-list {
        display: grid;
        border-top: 1px solid var(--color-border-hover);
    }

    .faq-item {
        border-bottom: 1px solid var(--color-border-hover);
    }

    .faq-item summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 44px;
        padding: 1.5rem 0;
        font-family: var(--font-heading);
        font-size: clamp(1.25rem, 2vw, 1.625rem);
        line-height: 1.25;
        color: var(--color-text-primary);
        cursor: pointer;
        list-style: none;
    }

    .faq-item summary::-webkit-details-marker {
        display: none;
    }

    .faq-item summary:hover {
        color: var(--color-accent-hover);
    }

    .faq-item summary:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 4px;
        border-radius: 2px;
    }

    .faq-icon {
        position: relative;
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
    }

    .faq-icon::before,
    .faq-icon::after {
        content: "";
        position: absolute;
        left: 0;
        top: 50%;
        width: 100%;
        height: 1.5px;
        background: var(--color-accent);
        transition: transform 0.3s ease;
    }

    .faq-icon::after {
        transform: rotate(90deg);
    }

    .faq-item[open] .faq-icon::after {
        transform: rotate(0deg);
    }

    .faq-item p {
        max-width: 44rem;
        padding-bottom: 1.75rem;
        font-size: 1rem;
        line-height: 1.7;
        color: var(--color-text-secondary);
    }

    .faq-item a {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 3px;
        border-radius: 2px;
    }

    .faq-item a:hover {
        color: var(--color-accent-hover);
    }

    .faq-item a:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 3px;
    }
</style>
