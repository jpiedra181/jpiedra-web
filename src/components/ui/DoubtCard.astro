---
//@ts-nocheck
// Tarjeta de una duda del cliente (rendimiento, móvil, accesibilidad, Google)
// con su ilustración. La ilustración repite lo que ya dice el texto, así que
// va oculta al lector de pantalla. La tarjeta se inclina hacia el cursor
// (.tilt-card en global.css y scripts/tilt-cards.ts).
interface DoubtVisual {
    score?: string
    scoreLabel?: string
    source?: string
    stats?: { value: string; label: string }[]
    width?: string
    key?: string
    button?: string
    reader?: string
    speech?: string
    url?: string
    title?: string
    description?: string
}

interface Props {
    item: {
        key: "speed" | "mobile" | "access" | "google"
        question: string
        answer: string
        visual: DoubtVisual
    }
}

const { item } = Astro.props
const { visual } = item
// El valor sobre 100 que dibuja el anillo de rendimiento.
const scoreValue = Number(visual.score ?? 0)
---

<div class="doubt-card tilt-card" data-tilt>
    <div class={`doubt-visual doubt-visual--${item.key}`} aria-hidden="true">
        {
            item.key === "speed" && (
                <div class="dv-speed">
                    <div class="dv-ring dv-layer-far">
                        <svg viewBox="0 0 120 120" focusable="false">
                            <circle class="dv-ring-track" cx="60" cy="60" r="52" />
                            <circle
                                class="dv-ring-value"
                                cx="60"
                                cy="60"
                                r="52"
                                pathLength="100"
                                style={`--score:${scoreValue}`}
                            />
                        </svg>
                        <span class="dv-ring-score">{visual.score}</span>
                    </div>
                    <div class="dv-speed-text dv-layer-mid">
                        <span class="dv-speed-label">{visual.scoreLabel}</span>
                        <span class="dv-speed-source">{visual.source}</span>
                    </div>
                    <span class="dv-chips dv-layer-near">
                        {visual.stats.map((stat) => (
                            <span class="dv-chip">
                                <b>{stat.value}</b> {stat.label}
                            </span>
                        ))}
                    </span>
                </div>
            )
        }

        {
            item.key === "mobile" && (
                <div class="dv-devices">
                    {(["desktop", "tablet", "phone"] as const).map((device) => (
                        <span class={`dv-device dv-device--${device}`}>
                            <span class="dv-screen">
                                <span class="dv-bar" />
                                <span class="dv-hero" />
                                <span class="dv-cards">
                                    <span />
                                    <span />
                                    <span />
                                </span>
                            </span>
                        </span>
                    ))}
                    <span class="dv-ruler">{visual.width}</span>
                </div>
            )
        }

        {
            item.key === "access" && (
                <div class="dv-access">
                    <span class="dv-key dv-layer-mid">{visual.key}</span>
                    <span class="dv-focus dv-layer-mid" lang="en">
                        {visual.button}
                    </span>
                    <span class="dv-speech dv-layer-near">
                        <span class="dv-speech-who">{visual.reader}</span>
                        <span class="dv-speech-text">«{visual.speech}»</span>
                    </span>
                </div>
            )
        }

        {
            item.key === "google" && (
                <div class="dv-serp">
                    <span class="dv-search dv-layer-mid">
                        <svg viewBox="0 0 20 20" focusable="false">
                            <circle cx="8.5" cy="8.5" r="5.5" />
                            <path d="M12.5 12.5 17 17" />
                        </svg>
                        <span class="dv-search-caret" />
                    </span>
                    <span class="dv-result dv-layer-near" lang="en">
                        <span class="dv-result-site">
                            <span class="dv-favicon" />
                            {visual.url}
                        </span>
                        <span class="dv-result-title">{visual.title}</span>
                        <span class="dv-result-desc">{visual.description}</span>
                    </span>
                </div>
            )
        }
    </div>

    <div class="doubt-text">
        <h4 class="doubt-question">{item.question}</h4>
        <p class="doubt-answer">{item.answer}</p>
    </div>

    <span class="tilt-card-glare" aria-hidden="true"></span>
</div>

<style>
    /* La mecánica de la inclinación y la luz está en .tilt-card (global.css). */
    .doubt-card {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    /* Capas a distinta profundidad: al inclinar la tarjeta se separan. Nada
       aquí lleva overflow: hidden, que aplanaría la escena. La altura es fija
       para que las cuatro preguntas empiecen a la misma altura. */
    .doubt-visual {
        position: relative;
        display: grid;
        place-items: center;
        height: 10.5rem;
        margin: 1.25rem 1.25rem 0;
        border: 1px solid rgb(232 200 114 / 0.1);
        border-radius: 0.875rem;
        background:
            linear-gradient(rgb(232 200 114 / 0.045) 1px, transparent 1px) 0 0 / 22px 22px,
            linear-gradient(90deg, rgb(232 200 114 / 0.045) 1px, transparent 1px) 0 0 / 22px 22px,
            rgb(11 15 20 / 0.7);
        transform: translateZ(18px);
        transform-style: preserve-3d;
    }

    .dv-layer-far {
        transform: translateZ(14px);
    }

    .dv-layer-mid {
        transform: translateZ(26px);
    }

    .dv-layer-near {
        transform: translateZ(40px);
    }

    .doubt-text {
        padding: 1.5rem 1.5rem 1.75rem;
        transform: translateZ(10px);
    }

    .doubt-question {
        font-size: 1.375rem;
        line-height: 1.2;
        color: var(--color-text-primary);
    }

    .doubt-answer {
        margin-top: 0.625rem;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--color-text-secondary);
    }

    /* --- Rendimiento: el anillo de Lighthouse --- */
    .dv-speed {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        gap: 0.75rem 0.9rem;
        width: 100%;
        padding: 0 1rem;
        transform-style: preserve-3d;
    }

    .dv-ring {
        position: relative;
        width: 4.75rem;
        aspect-ratio: 1;
    }

    .dv-ring svg {
        width: 100%;
        height: 100%;
        rotate: -90deg;
    }

    .dv-ring circle {
        fill: none;
        stroke-width: 9;
    }

    .dv-ring-track {
        stroke: rgb(232 200 114 / 0.12);
    }

    .dv-ring-value {
        stroke: var(--color-accent);
        stroke-linecap: round;
        stroke-dasharray: var(--score) 100;
        filter: drop-shadow(0 0 6px rgb(232 200 114 / 0.45));
    }

    .dv-ring-score {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-family: var(--font-heading);
        font-size: 1.75rem;
        color: var(--color-accent);
    }

    .dv-speed-text {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .dv-speed-label {
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-text-primary);
    }

    .dv-speed-source {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-text-secondary);
    }

    .dv-chips {
        grid-column: 1 / -1;
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
    }

    .dv-chip {
        padding: 0.2rem 0.5rem;
        border: 1px solid var(--color-border-hover);
        border-radius: 999px;
        background: rgb(11 15 20 / 0.85);
        font-size: 0.6875rem;
        color: var(--color-text-secondary);
        white-space: nowrap;
    }

    .dv-chip b {
        font-weight: 600;
        color: var(--color-text-primary);
    }

    /* El anillo se llena al entrar en pantalla, donde el navegador sabe
       animar con el scroll; en el resto se ve ya lleno. */
    @media (prefers-reduced-motion: no-preference) {
        @supports (animation-timeline: view()) {
            .dv-ring-value {
                animation: dv-ring-fill linear both;
                animation-timeline: view();
                animation-range: entry 10% cover 40%;
            }
        }
    }

    @keyframes dv-ring-fill {
        from {
            stroke-dasharray: 0 100;
        }
    }

    /* --- Móvil: la misma página en tres pantallas --- */
    .dv-devices {
        position: relative;
        width: 82%;
        height: 74%;
        transform-style: preserve-3d;
    }

    .dv-device {
        position: absolute;
        display: block;
        padding: 4px;
        border: 1.5px solid rgb(232 200 114 / 0.35);
        border-radius: 6px;
        background: rgb(20 26 35 / 0.95);
        box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.8);
    }

    .dv-device--desktop {
        left: 0;
        top: 0;
        width: 70%;
        height: 72%;
        transform: translateZ(8px);
    }

    .dv-device--tablet {
        left: 44%;
        top: 18%;
        width: 36%;
        height: 70%;
        border-radius: 8px;
        transform: translateZ(24px);
    }

    .dv-device--phone {
        left: 80%;
        top: 30%;
        width: 18%;
        height: 66%;
        border-color: var(--color-accent);
        border-radius: 9px;
        transform: translateZ(42px);
    }

    .dv-screen {
        display: flex;
        flex-direction: column;
        gap: 3px;
        height: 100%;
    }

    .dv-bar,
    .dv-hero,
    .dv-cards > span {
        display: block;
        border-radius: 2px;
        background: rgb(232 200 114 / 0.22);
    }

    .dv-bar {
        height: 5%;
        min-height: 3px;
        width: 40%;
    }

    .dv-hero {
        height: 30%;
        background: rgb(232 200 114 / 0.38);
    }

    /* Tres columnas en el ordenador, dos en la tableta y una en el móvil:
       lo que no cabe se reordena. */
    .dv-cards {
        display: grid;
        flex: 1;
        gap: 3px;
        grid-template-columns: repeat(3, 1fr);
    }

    .dv-device--tablet .dv-cards {
        grid-template-columns: repeat(2, 1fr);
    }

    .dv-device--tablet .dv-cards > span:last-child {
        grid-column: 1 / -1;
    }

    .dv-device--phone .dv-cards {
        grid-template-columns: 1fr;
    }

    .dv-ruler {
        position: absolute;
        left: 76%;
        bottom: -14%;
        padding: 0.1rem 0.4rem;
        border-radius: 3px;
        background: var(--color-accent);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--color-bg-primary);
        white-space: nowrap;
        transform: translateZ(48px);
    }

    /* --- Accesibilidad: teclado, foco y lector de pantalla --- */
    .dv-access {
        position: relative;
        width: 86%;
        height: 78%;
        transform-style: preserve-3d;
    }

    .dv-key {
        position: absolute;
        left: 0;
        bottom: 6%;
        display: grid;
        place-items: center;
        width: 3.5rem;
        height: 2.6rem;
        border: 1px solid rgb(255 255 255 / 0.18);
        border-radius: 0.5rem;
        background: linear-gradient(180deg, #2a3242, #1a2030);
        box-shadow:
            0 4px 0 #0c1018,
            0 10px 18px -6px rgb(0 0 0 / 0.8);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-text-primary);
    }

    .dv-focus {
        position: absolute;
        left: 34%;
        bottom: 12%;
        padding: 0.45rem 1rem;
        border-radius: 999px;
        background: var(--color-accent);
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--color-bg-primary);
        outline: 2px solid #fff;
        outline-offset: 4px;
    }

    .dv-speech {
        position: absolute;
        right: 0;
        top: 0;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        max-width: 78%;
        padding: 0.55rem 0.75rem;
        border: 1px solid var(--color-border-hover);
        border-radius: 0.75rem 0.75rem 0.75rem 0.2rem;
        background: rgb(11 15 20 / 0.94);
        box-shadow: 0 14px 30px -12px rgb(0 0 0 / 0.85);
    }

    .dv-speech-who {
        font-size: 0.625rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        color: var(--color-accent);
    }

    .dv-speech-text {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1.4;
        color: var(--color-text-primary);
    }

    /* --- Google: un resultado de búsqueda --- */
    .dv-serp {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        width: 88%;
        transform-style: preserve-3d;
    }

    .dv-search {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 70%;
        height: 1.6rem;
        padding: 0 0.75rem;
        border: 1px solid rgb(255 255 255 / 0.14);
        border-radius: 999px;
        background: #1c2433;
    }

    .dv-search svg {
        width: 0.85rem;
        height: 0.85rem;
        fill: none;
        stroke: var(--color-text-secondary);
        stroke-width: 2;
        stroke-linecap: round;
    }

    .dv-search-caret {
        width: 1px;
        height: 0.9rem;
        background: var(--color-text-primary);
    }

    @media (prefers-reduced-motion: no-preference) {
        .dv-search-caret {
            animation: dv-blink 1.1s steps(1) infinite;
        }
    }

    @keyframes dv-blink {
        50% {
            opacity: 0;
        }
    }

    .dv-result {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        padding: 0.55rem 0.75rem;
        border: 1px solid var(--color-border-hover);
        border-radius: 0.75rem;
        background: rgb(11 15 20 / 0.94);
        box-shadow: 0 16px 32px -14px rgb(0 0 0 / 0.85);
    }

    .dv-result-site {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.6875rem;
        color: var(--color-text-secondary);
    }

    .dv-favicon {
        width: 0.9rem;
        height: 0.9rem;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 35%, #f0d68a, #6e5a2a);
    }

    /* El azul de los enlaces de Google en modo oscuro: lo reconoce cualquiera. */
    .dv-result-title,
    .dv-result-desc {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .dv-result-title {
        font-size: 0.8125rem;
        line-height: 1.3;
        color: #8ab4f8;
    }

    .dv-result-desc {
        font-size: 0.6875rem;
        line-height: 1.45;
        color: var(--color-text-secondary);
    }
</style>
