---
// Pasos de un proceso como hitos de una ruta de montaña: el perfil real de
// una subida (MDT25 del IGN) con un hito por paso. Los pasos son una lista
// ordenada normal; el perfil es decorativo. GSAP lo dibuja con el scroll
// (initRouteSteps); sin JavaScript o con movimiento reducido se ve entero.
import type { ElevationProfileData } from "../../types"

interface Props {
    profile: ElevationProfileData
    steps: { title: string; description: string }[]
    label: string
}

const { profile, steps, label } = Astro.props

const VIEW_WIDTH = 1200
const VIEW_HEIGHT = 200
const SAMPLES = 160
// Margen arriba y abajo del perfil dentro de su caja.
const PAD_TOP = 0.12
const PAD_BOTTOM = 0.1

const step = (profile.heights.length - 1) / (SAMPLES - 1)
const heights = Array.from({ length: SAMPLES }, (_, i) => profile.heights[Math.round(i * step)])
heights[heights.length - 1] = profile.to.elevation
const low = Math.min(...heights)
const high = Math.max(...heights)
const yFraction = (metres: number) => PAD_TOP + (1 - (metres - low) / (high - low)) * (1 - PAD_TOP - PAD_BOTTOM)

const line = heights
    .map((metres, i) => `${i ? "L" : "M"}${((i / (SAMPLES - 1)) * VIEW_WIDTH).toFixed(1)} ${(yFraction(metres) * VIEW_HEIGHT).toFixed(1)}`)
    .join(" ")
const area = `${line} L${VIEW_WIDTH} ${VIEW_HEIGHT} L0 ${VIEW_HEIGHT} Z`

// Cada hito cae en el centro de su columna (1/6, 1/2, 5/6 con tres pasos).
const positions = steps.map((_, index) => (index + 0.5) / steps.length)
const heightAt = (fraction: number) => heights[Math.round(fraction * (SAMPLES - 1))]
---

<div class="route" data-route style={`--steps:${steps.length}`}>
    <div class="route-canvas" aria-hidden="true">
        <svg class="route-terrain" viewBox={`0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`} preserveAspectRatio="none" focusable="false">
            <defs>
                <linearGradient id="route-fill" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0" stop-color="#E8C872" stop-opacity="0.2"></stop>
                    <stop offset="1" stop-color="#E8C872" stop-opacity="0"></stop>
                </linearGradient>
            </defs>
            <path class="route-area" d={area} fill="url(#route-fill)"></path>
            <path class="route-line" d={line} vector-effect="non-scaling-stroke"></path>
        </svg>
        {
            positions.map((at, index) => (
                <span
                    class="route-marker"
                    data-at={at}
                    style={`--x:${at.toFixed(4)};--y:${yFraction(heightAt(at)).toFixed(4)}`}
                >
                    {index + 1}
                </span>
            ))
        }
    </div>

    <ol class="route-steps" aria-label={label}>
        {
            steps.map((item, index) => (
                <li class="route-step" data-at={positions[index]}>
                    <span class="route-step-number" aria-hidden="true">
                        {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3 class="route-step-title">{item.title}</h3>
                    <p class="route-step-text">{item.description}</p>
                </li>
            ))
        }
    </ol>
</div>

<style>
    .route-canvas {
        position: relative;
        height: 9rem;
    }

    .route-terrain {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .route-line {
        fill: none;
        stroke: var(--color-accent);
        stroke-width: 2;
        stroke-linejoin: round;
    }

    .route-marker {
        position: absolute;
        left: calc(var(--x) * 100%);
        top: calc(var(--y) * 100%);
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        margin: -15px 0 0 -15px;
        border: 1px solid var(--color-accent);
        border-radius: 50%;
        background: var(--color-bg-primary);
        box-shadow: 0 0 0 6px var(--color-bg-primary);
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--color-accent);
        transition:
            opacity 0.4s ease,
            scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
            background-color 0.4s ease,
            color 0.4s ease;
    }

    .route-marker:not(:global(.is-pending)) {
        background: var(--color-accent);
        color: var(--color-bg-primary);
    }

    .route-marker:global(.is-pending) {
        opacity: 0;
        scale: 0.3;
    }

    .route-steps {
        display: grid;
        gap: 2.5rem;
        margin-top: 3rem;
    }

    .route-step {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition:
            opacity 0.5s ease,
            translate 0.5s ease;
    }

    .route-step-number {
        font-family: var(--font-heading);
        font-size: 3rem;
        line-height: 1;
        color: var(--color-accent);
    }

    .route-step-title {
        font-family: var(--font-heading);
        font-size: clamp(1.5rem, 2.4vw, 2rem);
        line-height: 1.2;
        color: var(--color-text-primary);
    }

    .route-step-text {
        font-size: 1rem;
        line-height: 1.65;
        color: var(--color-text-secondary);
    }

    @media (min-width: 48rem) {
        .route-canvas {
            height: 12rem;
        }

        .route-steps {
            grid-template-columns: repeat(var(--steps), 1fr);
            gap: 3rem;
        }

        /* Un tallo baja de cada hito a su columna. */
        .route-step {
            position: relative;
            padding-top: 1.5rem;
            border-top: 1px dashed var(--color-accent-line);
        }

        /* Oculto del todo hasta que la ruta llega: medio transparente bajaría
           el contraste del texto mientras se ve. */
        .route-step:global(.is-pending) {
            opacity: 0;
            translate: 0 16px;
        }
    }
</style>
