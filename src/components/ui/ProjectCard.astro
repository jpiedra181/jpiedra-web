---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
    category: string
    title: string
    description: string
    tags: string[]
    image: ImageMetadata
    imageAlt: string
    imageFit?: "cover" | "contain"
    href: string
    cta: string
    reverse?: boolean
    // Posición en la serie, para numerar la hoja como en un juego de planos.
    index?: number
    total?: number
    sheetLabel?: string
    ofLabel?: string
    newWindowLabel: string
}

const {
    category,
    title,
    description,
    tags,
    image,
    imageAlt,
    imageFit = "cover",
    href,
    cta,
    reverse = false,
    index,
    total,
    sheetLabel = "Hoja",
    ofLabel = "de",
    newWindowLabel,
} = Astro.props

// La imagen en "cover" es más alta que su marco para que el parallax de GSAP
// (project-parallax) pueda desplazarla sin dejar un hueco abajo.
const imageClasses =
    imageFit === "cover"
        ? "project-parallax w-full h-[115%] object-cover transition-[scale] duration-700 group-hover:scale-105"
        : "w-full h-full object-contain p-6 md:p-10"

const pad = (value: number) => String(value).padStart(2, "0")
const sheetNumber = index === undefined ? undefined : pad(index + 1)
---

<article class="project-card group grid lg:grid-cols-2 gap-8 lg:gap-16 items-center">
    <span class="project-waypoint" aria-hidden="true"></span>

    <div class={`project-sheet relative ${reverse ? "lg:order-2" : ""}`}>
        {
            sheetNumber && (
                <p class="project-sheet-meta" aria-hidden="true">
                    <span>{sheetLabel} {sheetNumber}</span>
                    <span class="project-sheet-rule" />
                    <span>{total ? `${ofLabel} ${pad(total)}` : ""}</span>
                </p>
            )
        }
        <div class="project-image relative overflow-hidden rounded-xl">
            <div class="aspect-[16/10] overflow-hidden rounded-xl bg-bg-surface border border-border">
                <Image
                    src={image}
                    alt={imageAlt}
                    widths={[640, 960, 1280]}
                    sizes="(min-width: 1280px) 600px, (min-width: 1024px) 45vw, 100vw"
                    class={imageClasses}
                    loading="lazy"
                />
            </div>
            <div
                class="absolute inset-0 bg-gradient-to-t from-bg-primary/40 to-transparent rounded-xl pointer-events-none"
            >
            </div>
        </div>
        <span class="project-corner project-corner-tl" aria-hidden="true"></span>
        <span class="project-corner project-corner-tr" aria-hidden="true"></span>
        <span class="project-corner project-corner-bl" aria-hidden="true"></span>
        <span class="project-corner project-corner-br" aria-hidden="true"></span>
    </div>

    <div class={`project-copy relative ${reverse ? "lg:order-1" : ""}`}>
        {
            sheetNumber && (
                <span class="project-number" aria-hidden="true">
                    {sheetNumber}
                </span>
            )
        }
        <span class="project-category text-xs font-medium tracking-[0.15em] text-accent uppercase mb-4 block">
            {category}
        </span>
        <h3 class="project-title font-heading text-[clamp(1.75rem,3vw,2.5rem)] text-text-primary mb-4 leading-tight">
            {title}
        </h3>
        <p class="project-description text-text-secondary leading-relaxed mb-6">
            {description}
        </p>
        <ul role="list" class="flex flex-wrap gap-2 mb-8">
            {
                tags.map((tag) => (
                    <li class="project-tag text-xs text-text-secondary bg-bg-elevated border border-border rounded-full px-3 py-1">
                        {tag}
                    </li>
                ))
            }
        </ul>
        <!-- Los proyectos se abren siempre en otra pestaña (decisión de Javier):
             se avisa en texto para quien no ve la flecha (WCAG G201). -->
        <a
            href={href}
            target="_blank"
            rel="noopener"
            class="project-link inline-flex items-center gap-2 text-base font-medium text-accent hover:text-accent-hover underline-offset-4 hover:underline transition-colors duration-200 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white group/link"
        >
            {cta}
            <span class="sr-only">({newWindowLabel})</span>
            <span
                aria-hidden="true"
                class="transition-transform duration-200 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
                >↗</span
            >
        </a>
    </div>
</article>

<style>
    .project-card {
        position: relative;
    }

    .project-copy {
        isolation: isolate;
    }

    /* Marcas de corte en las esquinas, como en una hoja de plano impresa. */
    .project-corner {
        position: absolute;
        width: 14px;
        height: 14px;
        border-color: var(--color-accent);
        border-style: solid;
        border-width: 0;
        opacity: 0.7;
    }

    .project-corner-tl {
        left: -10px;
        top: calc(var(--sheet-meta, 0px) - 10px);
        border-left-width: 1px;
        border-top-width: 1px;
    }

    .project-corner-tr {
        right: -10px;
        top: calc(var(--sheet-meta, 0px) - 10px);
        border-right-width: 1px;
        border-top-width: 1px;
    }

    .project-corner-bl {
        left: -10px;
        bottom: -10px;
        border-left-width: 1px;
        border-bottom-width: 1px;
    }

    .project-corner-br {
        right: -10px;
        bottom: -10px;
        border-right-width: 1px;
        border-bottom-width: 1px;
    }

    .project-sheet:has(.project-sheet-meta) {
        --sheet-meta: 2.25rem;
    }

    .project-sheet-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        height: 1.25rem;
        margin-bottom: 1rem;
        font-size: 0.6875rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-variant-numeric: tabular-nums;
        color: var(--color-text-secondary);
    }

    .project-sheet-rule {
        flex: 1;
        height: 1px;
        background: var(--color-accent-line);
    }

    /* Número de hoja grande y en hueco, detrás del texto. */
    .project-number {
        position: absolute;
        right: 0;
        top: -0.35em;
        z-index: -1;
        font-family: var(--font-heading);
        font-size: clamp(6rem, 12vw, 10rem);
        line-height: 1;
        color: transparent;
        -webkit-text-stroke: 1px rgb(232 200 114 / 0.22);
        pointer-events: none;
        user-select: none;
    }

    .project-waypoint {
        display: none;
    }

    @media (min-width: 64rem) {
        /* Hito de la ruta que une los proyectos: en el centro del hueco entre
           imagen y texto, por donde pasa el trazo de Projects.astro. */
        .project-waypoint {
            display: block;
            position: absolute;
            left: 50%;
            top: 50%;
            width: 13px;
            height: 13px;
            margin: -6.5px 0 0 -6.5px;
            border: 1px solid var(--color-accent);
            border-radius: 50%;
            background: var(--color-bg-primary);
            box-shadow: 0 0 0 5px var(--color-bg-primary);
            z-index: 1;
        }

        .project-waypoint::after {
            content: "";
            position: absolute;
            inset: 3px;
            border-radius: 50%;
            background: var(--color-accent);
        }
    }
</style>
