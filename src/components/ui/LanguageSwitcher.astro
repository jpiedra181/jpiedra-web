---
// Enlace a la misma página en el otro idioma (src/config/page-pairs.json). Si
// la página solo existe en un idioma (blog, autoevaluador), lleva a la home
// del otro. Se ve "EN"/"ES" y se anuncia con el nombre del idioma, en su
// propio idioma para que el lector de pantalla lo pronuncie bien.
import type { Lang } from "../../types"
import { pairFor, routesFor } from "../../config/site"

interface Props {
    lang: Lang
    class?: string
}

const { lang, class: className = "" } = Astro.props
const target: Lang = lang === "es" ? "en" : "es"
const pair = pairFor(Astro.url.pathname)
const href = pair ? pair[target] : routesFor(target).home
const NAMES = { en: "English", es: "Español" } as const
---

<a href={href} hreflang={target} lang={target} class={`language-switch ${className}`}>
    <span>{target.toUpperCase()}</span>
    <span class="sr-only"> ({NAMES[target]})</span>
</a>

<style>
    .language-switch {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        min-height: 36px;
        padding: 0.25rem 0.75rem;
        border: 1px solid var(--color-border-hover);
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        color: var(--color-text-secondary);
        transition:
            color 0.2s ease,
            border-color 0.2s ease;
    }

    .language-switch:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
    }

    .language-switch:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
    }
</style>
