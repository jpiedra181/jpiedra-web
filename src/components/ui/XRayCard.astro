---
//@ts-nocheck
// Ficha de producto de ejemplo, en dos versiones con la misma maqueta: la
// que ve cualquiera ("visual") y lo que anuncia un lector de pantalla
// ("reader"). XRayProduct.astro las superpone y la lupa enseña la segunda.
// Cada fila mide lo mismo en las dos para que la lupa caiga en su sitio.
interface Props {
    mode: "visual" | "reader"
    product: Record<string, string>
    reader: Record<string, string>
}

const { mode, product, reader } = Astro.props
const visual = mode === "visual"
const SWATCHES = ["#5d7f86", "#c98e5b", "#e8e2d6"]
---

<div class:list={["xc", visual ? "xc-visual" : "xc-reader"]}>
    <div class="xc-image" data-problem>
        {
            visual ? (
                <svg viewBox="0 0 120 150" class="xc-vase">
                    <defs>
                        <linearGradient id="xc-vase-glaze" x1="0" x2="1" y1="0" y2="0">
                            <stop offset="0" stop-color="#4f727a" />
                            <stop offset="0.45" stop-color="#a5c3c3" />
                            <stop offset="1" stop-color="#36545c" />
                        </linearGradient>
                    </defs>
                    <ellipse cx="60" cy="142" rx="34" ry="5" fill="rgb(0 0 0 / 0.18)" />
                    <path
                        d="M46 12 h28 v8 c0 8 -6 12 -6 20 c0 14 26 26 26 56 c0 26 -14 42 -28 44 h-12 c-14 -2 -28 -18 -28 -44 c0 -30 26 -42 26 -56 c0 -8 -6 -12 -6 -20 z"
                        fill="url(#xc-vase-glaze)"
                    />
                    <path d="M44 12 h32" stroke="#2f474d" stroke-width="3" stroke-linecap="round" />
                    <path d="M38 92 c10 7 34 7 44 0" stroke="rgb(255 255 255 / 0.35)" stroke-width="2" fill="none" />
                </svg>
            ) : (
                <span class="xc-note">{reader.image}</span>
            )
        }
    </div>

    <div class="xc-body">
        <div class="xc-line xc-rating" data-problem>
            {
                visual ? (
                    <span>
                        <span class="xc-stars">★★★★☆</span> {product.reviews}
                    </span>
                ) : (
                    <span class="xc-note">{reader.rating}</span>
                )
            }
        </div>
        <div class="xc-line xc-name">
            {visual ? product.name : <span class="xc-note">{reader.heading}</span>}
        </div>
        <div class="xc-line xc-detail">{visual ? product.detail : ""}</div>
        <div class="xc-line xc-price">
            {visual ? product.price : <span class="xc-note">{reader.price}</span>}
        </div>

        <div class="xc-line xc-control" data-problem>
            {
                visual ? (
                    <>
                        <span class="xc-label">{product.colors}</span>
                        <span class="xc-swatches">
                            {SWATCHES.map((color) => (
                                <span class="xc-swatch" style={`background:${color}`} />
                            ))}
                        </span>
                    </>
                ) : (
                    <span class="xc-note">
                        {reader.color} · {reader.color} · {reader.color}
                    </span>
                )
            }
        </div>

        <div class="xc-line xc-control" data-problem>
            {
                visual ? (
                    <>
                        <span class="xc-label">{product.quantity}</span>
                        <span class="xc-quantity">
                            <span>−</span>
                            <span class="xc-count">1</span>
                            <span>+</span>
                        </span>
                    </>
                ) : (
                    <span class="xc-note">
                        {reader.minus} · {reader.quantity} · {reader.plus}
                    </span>
                )
            }
        </div>

        <div class="xc-line xc-actions" data-problem>
            {
                visual ? (
                    <>
                        <span class="xc-cart">
                            <svg viewBox="0 0 24 24" class="xc-icon">
                                <path d="M3 4h2l2.4 10.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.5L21 8H6.2" />
                                <circle cx="10" cy="20" r="1.4" />
                                <circle cx="17" cy="20" r="1.4" />
                            </svg>
                        </span>
                        <span class="xc-favorite">
                            <svg viewBox="0 0 24 24" class="xc-icon">
                                <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" />
                            </svg>
                        </span>
                    </>
                ) : (
                    <span class="xc-note">
                        {reader.cart} · {reader.favorite}
                    </span>
                )
            }
        </div>
    </div>
</div>

<style>
    .xc {
        display: grid;
        grid-template-columns: 42% 1fr;
        gap: 1.5rem;
        height: 100%;
        padding: 1.5rem;
        border-radius: 1rem;
    }

    .xc-body {
        display: grid;
        grid-template-rows: 1.25rem 2.25rem 1.25rem 2.25rem 3rem 3rem 3.25rem;
        row-gap: 0.4rem;
        align-content: center;
    }

    .xc-line {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
    }

    .xc-image {
        display: grid;
        place-items: center;
        border-radius: 0.75rem;
    }

    /* La ficha "normal": clara, como cualquier tienda online. */
    .xc-visual {
        background: #f3f0ea;
        color: #1d2026;
        box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.8);
    }

    .xc-visual .xc-image {
        background: linear-gradient(160deg, #e6e0d6, #d6cec1);
    }

    .xc-vase {
        width: 62%;
        height: auto;
    }

    .xc-visual .xc-rating {
        font-size: 0.75rem;
        color: #5b5e63;
    }

    .xc-stars {
        color: #b57d1c;
        letter-spacing: 0.08em;
    }

    .xc-visual .xc-name {
        font-family: var(--font-heading);
        font-size: 1.75rem;
        line-height: 1;
    }

    .xc-visual .xc-detail {
        font-size: 0.8125rem;
        color: #5b5e63;
    }

    .xc-visual .xc-price {
        font-size: 1.25rem;
        font-weight: 600;
    }

    .xc-label {
        width: 4.5rem;
        font-size: 0.75rem;
        color: #5b5e63;
    }

    .xc-swatches {
        display: flex;
        gap: 0.5rem;
    }

    .xc-swatch {
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 50%;
        box-shadow:
            inset 0 0 0 1px rgb(0 0 0 / 0.15),
            0 0 0 2px #f3f0ea,
            0 0 0 3px rgb(0 0 0 / 0.1);
    }

    .xc-swatch:first-child {
        box-shadow:
            inset 0 0 0 1px rgb(0 0 0 / 0.15),
            0 0 0 2px #f3f0ea,
            0 0 0 3px #1d2026;
    }

    .xc-quantity {
        display: flex;
        align-items: center;
        border: 1px solid #c9c3b8;
        border-radius: 999px;
    }

    .xc-quantity span {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        font-size: 1rem;
    }

    .xc-visual .xc-actions {
        gap: 0.625rem;
    }

    .xc-cart {
        display: grid;
        place-items: center;
        flex: 1;
        height: 3rem;
        border-radius: 999px;
        background: #1d2026;
    }

    .xc-cart .xc-icon {
        stroke: #f3f0ea;
    }

    .xc-favorite {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        border: 1px solid #c9c3b8;
        border-radius: 50%;
    }

    .xc-icon {
        width: 1.375rem;
        height: 1.375rem;
        fill: none;
        stroke: #1d2026;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* Lo que oye un lector de pantalla: la misma maqueta en alambre, con lo
       que anuncia cada pieza. Las barreras, en dorado. */
    .xc-reader {
        background:
            repeating-linear-gradient(0deg, rgb(232 200 114 / 0.04) 0 1px, transparent 1px 22px),
            #0d1218;
        box-shadow: inset 0 0 0 1px rgb(232 200 114 / 0.35);
    }

    .xc-reader .xc-image,
    .xc-reader .xc-line {
        padding: 0 0.625rem;
        border: 1px dashed rgb(226 228 231 / 0.25);
        border-radius: 0.5rem;
    }

    .xc-reader [data-problem] {
        border-color: rgb(232 200 114 / 0.75);
        background: rgb(232 200 114 / 0.07);
    }

    .xc-reader .xc-detail {
        border-style: none;
    }

    .xc-note {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1.3;
        color: var(--color-text-primary);
    }

    .xc-reader [data-problem] .xc-note {
        color: var(--color-accent);
    }

    .xc-reader [data-problem] .xc-note::before {
        content: "!";
        display: inline-grid;
        place-items: center;
        width: 1rem;
        height: 1rem;
        margin-right: 0.5rem;
        border-radius: 50%;
        background: var(--color-accent);
        color: var(--color-bg-primary);
        font-weight: 700;
        font-size: 0.6875rem;
    }

    @media (max-width: 30rem) {
        .xc {
            grid-template-columns: 1fr;
            grid-template-rows: 9rem auto;
            gap: 1rem;
            padding: 1.125rem;
        }

        .xc-vase {
            width: auto;
            height: 85%;
        }
    }
</style>
