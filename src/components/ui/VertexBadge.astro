---
// Rótulo de vértice geodésico: cada landing cuelga de una cumbre de la home
// 3D (V·01 Peñalara, V·02 Siete Picos…). Es un guiño visual: se oculta a los
// lectores de pantalla, que no ganan nada oyendo «V·01».
import { surveyVertices } from "../../data/survey-vertices"
import { formatElevation } from "../../lib/format"
import { getLangFromUrl } from "../../i18n/utils"

interface Props {
    vertex: string
    class?: string
}

const { vertex: id, class: className = "" } = Astro.props
const vertex = surveyVertices.find((item) => item.id === id)
---

{
    vertex && (
        <p class={`vertex-badge ${className}`} aria-hidden="true">
            <svg viewBox="0 0 14 12" class="vertex-badge-mark">
                <path d="M7 1 L13 11 L1 11 Z" />
                <circle cx="7" cy="7.6" r="1.3" />
            </svg>
            <span class="vertex-badge-code">{vertex.code}</span>
            <span>{vertex.peak}</span>
            <span class="vertex-badge-elevation">{formatElevation(vertex.elevation, getLangFromUrl(Astro.url))}</span>
        </p>
    )
}

<style>
    .vertex-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.375rem 0.875rem 0.375rem 0.625rem;
        border: 1px solid var(--color-border-hover);
        border-radius: 999px;
        background: rgb(11 15 20 / 0.7);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        color: var(--color-text-primary);
    }

    .vertex-badge-mark {
        width: 14px;
        height: 12px;
    }

    .vertex-badge-mark path {
        fill: none;
        stroke: var(--color-accent);
        stroke-width: 1.3;
    }

    .vertex-badge-mark circle {
        fill: var(--color-accent);
    }

    .vertex-badge-code,
    .vertex-badge-elevation {
        color: var(--color-accent);
        font-variant-numeric: tabular-nums;
    }
</style>
