---
//@ts-nocheck
// Un agente de IA intenta una compra en la misma ficha de producto de la
// landing de accesibilidad (el jarrón Alba): primero tal como está y después
// arreglada. Es texto real (se lee con lector de pantalla); la animación solo
// lo va mostrando línea a línea (agent-demo.ts).
interface Props {
    copy: Record<string, any>
}

const { copy } = Astro.props
const versions = ["broken", "fixed"] as const
---

<figure class="agent" data-agent data-state="broken">
    <div class="agent-window">
        <div class="agent-bar" aria-hidden="true">
            <span class="agent-dots"><span></span><span></span><span></span></span>
            <span class="agent-bar-title">{copy.window}</span>
        </div>

        <div class="agent-task">
            <span class="agent-task-label">{copy.taskLabel}</span>
            <p class="agent-task-text">{copy.task}</p>
        </div>

        <div class="agent-versions" role="group" aria-label={copy.versionsLabel}>
            {
                versions.map((version) => (
                    <button type="button" data-version={version} aria-pressed={version === "broken" ? "true" : "false"}>
                        {copy[version]}
                    </button>
                ))
            }
        </div>

        <div class="agent-panes">
            <div class="agent-pane">
                <p class="agent-pane-label">{copy.readsLabel}</p>
                {
                    versions.map((version) => (
                        <ul role="list" class="agent-snapshot" data-for={version} hidden={version !== "broken"}>
                            {copy.snapshot[version].map((item, index) => (
                                <li class:list={{ "is-problem": item.problem }} style={`--i:${index}`}>
                                    <code>{item.line}</code>
                                    {item.note && <span class="agent-note">← {item.note}</span>}
                                </li>
                            ))}
                        </ul>
                    ))
                }
            </div>

            <div class="agent-pane">
                <p class="agent-pane-label">{copy.doesLabel}</p>
                {
                    versions.map((version) => (
                        <div data-for={version} hidden={version !== "broken"}>
                            <ol role="list" class="agent-log">
                                {copy.log[version].map((line, index) => (
                                    <li style={`--i:${index}`}>{line}</li>
                                ))}
                            </ol>
                            <p
                                class:list={["agent-result", version === "broken" ? "is-fail" : "is-ok"]}
                                style={`--i:${copy.log[version].length}`}
                            >
                                {copy.result[version]}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    <p class="sr-only" aria-live="polite" data-agent-status></p>
    <figcaption class="agent-caption">{copy.caption}</figcaption>
</figure>

<style>
    .agent {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .agent-window {
        border: 1px solid var(--color-border-hover);
        border-radius: 1rem;
        background:
            radial-gradient(40rem 20rem at 100% 0%, rgb(232 200 114 / 0.07), transparent 60%),
            #0d1218;
        box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.85);
        overflow: hidden;
    }

    .agent-bar {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1.125rem;
        border-bottom: 1px solid var(--color-border);
        background: rgb(255 255 255 / 0.02);
    }

    .agent-dots {
        display: flex;
        gap: 0.375rem;
    }

    .agent-dots span {
        width: 0.625rem;
        height: 0.625rem;
        border-radius: 50%;
        background: var(--color-bg-elevated);
    }

    .agent-bar-title {
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        color: var(--color-text-secondary);
    }

    .agent-bar-title::before {
        content: "";
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        margin-right: 0.5rem;
        border-radius: 50%;
        background: #7fd18b;
        box-shadow: 0 0 8px #7fd18b;
    }

    .agent-task {
        padding: 1.25rem 1.5rem 0;
    }

    .agent-task-label,
    .agent-pane-label {
        font-size: 0.6875rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-accent);
    }

    .agent-task-text {
        margin-top: 0.375rem;
        font-family: var(--font-heading);
        font-size: clamp(1.25rem, 2vw, 1.625rem);
        line-height: 1.2;
        color: var(--color-text-primary);
    }

    .agent-versions {
        display: inline-flex;
        margin: 1.25rem 1.5rem 0;
        padding: 0.25rem;
        border: 1px solid var(--color-border-hover);
        border-radius: 999px;
    }

    .agent-versions button {
        min-height: 40px;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-text-secondary);
        cursor: pointer;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
    }

    .agent-versions button[aria-pressed="true"] {
        background: var(--color-accent);
        color: var(--color-bg-primary);
    }

    .agent-versions button:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
    }

    /* Invita a probar la versión arreglada cuando acaba la primera vuelta. */
    @media (prefers-reduced-motion: no-preference) {
        .agent.is-hinting [data-version="fixed"][aria-pressed="false"] {
            animation: agent-hint 1.2s ease-in-out 3;
        }
    }

    @keyframes agent-hint {
        50% {
            box-shadow: 0 0 0 4px rgb(232 200 114 / 0.35);
            color: var(--color-text-primary);
        }
    }

    .agent-panes {
        display: grid;
        gap: 1.5rem;
        padding: 1.5rem;
    }

    .agent-snapshot,
    .agent-log {
        display: grid;
        gap: 0.375rem;
        margin-top: 0.75rem;
    }

    .agent-snapshot code {
        font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
        font-size: 0.8125rem;
        line-height: 1.4;
        white-space: pre;
        color: var(--color-text-primary);
    }

    .agent-snapshot .is-problem code {
        color: var(--color-accent);
    }

    .agent-note {
        margin-left: 0.625rem;
        font-size: 0.75rem;
        color: var(--color-text-secondary);
    }

    .agent-log li {
        position: relative;
        padding-left: 1.25rem;
        font-size: 0.9375rem;
        line-height: 1.45;
        color: var(--color-text-primary);
    }

    .agent-log li::before {
        content: "›";
        position: absolute;
        left: 0;
        color: var(--color-accent);
    }

    .agent-result {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1rem;
        padding: 0.375rem 0.875rem;
        border-radius: 999px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .agent-result.is-fail {
        background: rgb(240 138 122 / 0.14);
        color: #f4a294;
    }

    .agent-result.is-ok {
        background: rgb(127 209 139 / 0.14);
        color: #8fdc9a;
    }

    .agent-result::before {
        content: "";
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: currentColor;
    }

    /* Una vuelta del agente: las líneas aparecen una tras otra. Con
       movimiento reducido (o sin JS) se ve todo de golpe. */
    @media (prefers-reduced-motion: no-preference) {
        .agent.is-playing .agent-log li,
        .agent.is-playing .agent-result {
            animation: agent-line 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
            animation-delay: calc(0.35s + var(--i) * 0.8s);
        }

        .agent.is-playing .agent-snapshot li {
            animation: agent-line 0.35s ease-out both;
            animation-delay: calc(var(--i) * 0.05s);
        }
    }

    @keyframes agent-line {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    .agent-caption {
        max-width: 38rem;
        font-size: 0.8125rem;
        line-height: 1.6;
        color: var(--color-text-secondary);
    }

    @media (min-width: 40rem) {
        .agent-panes {
            grid-template-columns: 1.05fr 0.95fr;
        }
    }
</style>
