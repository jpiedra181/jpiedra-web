---
//@ts-nocheck
import { getCollection, render, type CollectionEntry } from "astro:content"
import BaseLayout from "../../components/layout/BaseLayout.astro"
import ArticleSchema from "../../components/layout/ArticleSchema.astro"
import "../../styles/article-prose.css"

export async function getStaticPaths() {
    const posts = await getCollection("blog")
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }))
}

interface Props {
    post: CollectionEntry<"blog">
}

const { post } = Astro.props
const { Content } = await render(post)
const lang = "es" as const

// URL canónica del post
const canonicalURL = new URL(`/blog/${post.id}/`, Astro.site).toString()
// Los títulos de los artículos ya son largos: la marca solo se añade si cabe
// en lo que enseña Google (unos 65 caracteres).
const BRAND_SUFFIX = " — Javier Piedra"
const SEO_TITLE_MAX = 65
const seoTitle =
    post.data.title.length + BRAND_SUFFIX.length <= SEO_TITLE_MAX ? `${post.data.title}${BRAND_SUFFIX}` : post.data.title
---

<BaseLayout
    lang={lang}
    title={seoTitle}
    description={post.data.description}
>
    <ArticleSchema
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        updatedDate={post.data.updatedDate}
        heroImage={post.data.heroImage}
        heroImageAlt={post.data.heroImageAlt}
        url={canonicalURL}
        tags={post.data.tags}
        category={post.data.category}
    />
    <article class="relative py-24 md:py-32 lg:py-40">
        <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
            <header class="max-w-3xl mb-16 md:mb-20">
                <a
                    href="/blog/"
                    class="inline-flex items-center min-h-[24px] text-sm text-text-secondary hover:text-accent transition-colors mb-8 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                >
                    ← Volver al blog
                </a>

                <time
                    datetime={post.data.pubDate.toISOString()}
                    class="block text-sm text-text-muted mb-4"
                >
                    {
                        post.data.pubDate.toLocaleDateString("es-ES", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </time>

                <h1
                    class="font-heading text-[clamp(2.25rem,5vw,4.5rem)] leading-[1.1] text-text-primary mb-6"
                    style="text-wrap: balance;"
                >
                    {post.data.title}
                </h1>

                <p
                    class="text-lg md:text-xl text-text-secondary leading-relaxed"
                >
                    {post.data.description}
                </p>
                {
                    post.data.heroImage && (
                        <figure class="mt-12">
                            <img
                                src={post.data.heroImage}
                                alt={post.data.heroImageAlt ?? ""}
                                loading="eager"
                                decoding="async"
                                class="w-full rounded-lg"
                            />
                        </figure>
                    )
                }
            </header>

            <div class="article-prose max-w-3xl">
                <Content />
            </div>
        </div>
    </article>
</BaseLayout>
