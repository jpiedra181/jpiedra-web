---
import BaseLayout from "../components/layout/BaseLayout.astro"
import Hero from "../components/sections/Hero.astro"
import AutoevaluadorCTA from "../components/sections/AutoevaluadorCTA.astro"
import Context from "../components/sections/Context.astro"
import About from "../components/sections/About.astro"
import Approach from "../components/sections/Approach.astro"
import CaseStudy from "../components/sections/CaseStudy.astro"
import Projects from "../components/sections/Projects.astro"
import Contact from "../components/sections/Contact.astro"

const lang = "es" as const

const title =
    "Accesibilidad web para empresas — Ley 11/2023 y WCAG 2.1 AA | Javier Piedra"
const description =
    "Cada barrera de tu web es un cliente que no termina de comprar. Audito y arreglo webs según WCAG 2.1 AA y la Ley 11/2023. Diagnóstico exprés desde 290 €."
---

<BaseLayout lang={lang} title={title} description={description}>
    <Hero lang={lang} />
    <AutoevaluadorCTA />
    <Context lang={lang} />
    <About lang={lang} />
    <Approach lang={lang} />
    <CaseStudy />
    <!-- <Projects lang={lang} /> -->
    <!-- <Contact lang={lang} /> -->
</BaseLayout>

<script>
    import {
        initHeroAnimations,
        initScrollAnimations,
        destroyAnimations,
    } from "../scripts/gsap-animations"

    initHeroAnimations()
    initScrollAnimations()

    document.addEventListener(
        "astro:before-swap",
        () => {
            destroyAnimations()
        },
        { once: true },
    )
</script>
